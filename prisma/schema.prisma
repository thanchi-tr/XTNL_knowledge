// Gamified Spaced Repetition System — core data architecture.
// pgvector's `vector` column type is not a first-class Prisma type: it is declared
// via `Unsupported("vector(1536)")`, which means Prisma Migrate cannot create or
// alter it. The extension, the column, and its ANN index are created by the raw
// SQL migration in prisma/migrations/0_init/migration.sql instead — see that file
// and README.md "Database setup" for the full sequence.

generator client {
  provider = "prisma-client-js"

  // `relationJoins` lets a query opt into `relationLoadStrategy: "join"`,
  // which fetches a nested relation with a LATERAL JOIN instead of issuing a
  // second query and stitching the rows together in the client.
  //
  // That default cost a round trip per relation, which is invisible on a
  // local database and ruinous on a remote one: profiling showed every page
  // paying separate SELECTs for Field *and* FieldAttribute, Domain *and*
  // DomainAttribute, purely because they were expressed as nested selects.
  // At ~160ms per hop to Seoul, each of those was a sixth of the entire
  // performance budget for the page.
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
  // Single-schema mode. If you ever point this at a Supabase project whose
  // `public` schema has its own FK into `auth` (e.g. a custom `entities`
  // table), `prisma migrate`/`db pull` will fail with P4002 asking for
  // `schemas = ["public", "auth"]`. Don't add that pre-emptively — declaring
  // `auth` here makes Prisma's drift detection treat that whole schema as
  // something it should match against migration history, and since we never
  // define any auth.* models, every future `migrate dev` interprets
  // Supabase's own auth tables as un-reconcilable drift and offers to reset
  // both schemas. Add it back only if P4002 actually reappears, and expect
  // that warning again if you do.
  schemas    = ["public"]
}

enum CollectionLabel {
  BOOK
  ACTIONABLE
  PROPOSAL

  @@schema("public")
}

/**
 * How an Idea is drilled, and therefore how its answer is graded.
 * Each value has a verifier in `verification.ts`, an encoder in
 * `idea-payload.ts`, and a base XP in `xp.ts` — the switches over this enum
 * are deliberately exhaustive so adding a member fails to compile until
 * every one of them has been taught about it.
 */
enum QuestionType {
  /**
   * Free recall, graded on Dice-coefficient similarity.
   */
  SHORT
  /**
   * One correct option out of several.
   */
  MULTI
  /**
   * Labelled hotspots over an image.
   */
  DIAGRAM
  /**
   * Symbolic expression, graded by algebraic equivalence.
   */
  FORMULA
  /**
   * Fill-in-the-blank. One prompt yields as many blanks as it marks.
   */
  CLOZE
  /**
   * Enumerate a set of items; order irrelevant, completeness required.
   */
  LIST
  /**
   * Arrange items into the correct sequence.
   */
  ORDER
  /**
   * A number, graded within a tolerance, optionally carrying a unit.
   */
  NUMERIC

  @@schema("public")
}

/**
 * The thirteen base attributes every Field is composed from.
 * These are the substrate of the whole progression system: a Field declares
 * what mix of them it trains, Field levels flow into attribute scores
 * weighted by that mix, and skills gate on attribute scores. Nothing here
 * is per-Field hardcoded — the previous skill system keyed off literal
 * seeded Domain names like "Memory & Cognition", which meant renaming a
 * Domain silently disabled a skill and no user-created Field could ever
 * unlock anything.
 */
enum Attribute {
  MIND
  PHYSICAL
  CRITICAL_THINKING
  COMPASSION
  ABSTRACT
  LOGIC
  REASON
  REBUTTAL
  SELF_RESPECT
  FAITH
  CREATIVITY
  STUBBORNNESS
  STATISTIC

  @@schema("public")
}

model Field {
  id          String             @id @default(cuid())
  name        String             @unique
  level       Float              @default(0)
  /// The last drop of `level` (2026-10-13, migration 20261223000000_idea_leveling): from which level and when.
  droppedFrom Float?
  droppedAt   DateTime?
  domains     Domain[]
  snapshots   FieldSnapshot[]
  attributes  FieldAttribute[]
  streaks     FieldStreak[]
  bosses      BossEncounter[]
  maintenance FieldMaintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Domain {
  id                    String            @id @default(cuid())
  name                  String
  fieldId               String
  field                 Field             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  totalPoints           Float             @default(0)
  level                 Int               @default(0)
  /// The last drop of `level` (2026-10-13, migration 20261223000000_idea_leveling): from which level and when, so
  /// the Library and the bell can say "fell to L3".
  droppedFrom           Int?
  droppedAt             DateTime?
  ideas                 Idea[]
  attributes            DomainAttribute[]
  /**
   * How many Ideas have been folded into `attributes` so far.
   * Not the same as `ideas.length`: it is the observation count the running
   * blend in `attribute-inference.ts` divides by, so a Domain's identity
   * stabilises as it fills. Kept as its own counter because deletions
   * should not make the next submission swing the Domain harder.
   */
  attributeObservations Int               @default(0)
  /// Revision 5 (roadmap migration B, decision 63): 'GEMINI' when accept created it from a kept Gemini name; null = the user's (every row before revision 5).
  nameOrigin            String?
  /// Revision 5: the name as Gemini gave it. The Gemini mark shows while name = originName, so a rename removes it (roadmap-types geminiNamedOf).
  originName            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@schema("public")
}

/**
 * A Domain's inferred attribute split (attribute-inference.ts).
 * Mirrors `FieldAttribute` deliberately. A Field's name is a label someone
 * chose once; its Domains are where the subject is actually described, and
 * its Ideas are where it is described in detail. Storing the split here is
 * what lets `effectiveFieldComposition` weight a Field by what its Domains
 * turned out to be about rather than by whatever it was named.
 */
model DomainAttribute {
  id        String    @id @default(cuid())
  domainId  String
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  attribute Attribute
  /**
   * 0-100, summing to 100 across the thirteen.
   */
  weight    Int       @default(0)

  @@unique([domainId, attribute])
  @@index([domainId])
  @@schema("public")
}

model Idea {
  id                  String          @id @default(cuid())
  domainId            String
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  collectionLabel     CollectionLabel
  level               Int             @default(1) // 1..20 (MASTERY_LEVEL 12; 13..20 the post-mastery ladder)
  /// Clean recalls in a row (2026-10-13, migration 20261223000000_idea_leveling): a recall with no miss in its due
  /// cycle. From L8 up a level needs two in a row; a miss resets it.
  cleanStreak         Int             @default(0)
  /// Per-idea ease (2026-10-14, migration 20261226000000_idea_ease): scales the ladder's baseline interval for this
  /// idea (Ebbinghaus stability S = baseline(level) x ease / ln(1/0.9)); learnt from its recalls, 1 = the baseline.
  ease                Float           @default(1)
  /// A miss happened in the current due cycle (a recall in it is not clean); cleared when a new cycle is scheduled.
  cycleMissed         Boolean         @default(false)
  /// The life day of the latest miss: a miss counts once a day (re-attempts in a session add nothing).
  lapseDay            DateTime?       @db.Date
  basePoints          Float           @default(0)
  yieldPoints         Float           @default(0)
  fragments           Int             @default(1)
  question            String // JSON stringified for complex types (MULTI options, DIAGRAM hotspots)
  questionType        QuestionType
  answer              String // JSON stringified for complex types
  /// Capitals must match when grading (SHORT answers, cloze blanks, LIST items). Chosen when the idea is written; off by default.
  answerCaseSensitive Boolean         @default(false)
  dueDate             DateTime
  graceEndsAt         DateTime?
  failedAttempts      Int             @default(0)
  endorsements        Int             @default(0)
  isArchived          Boolean         @default(false)
  linkedIdeaIds       String[]        @default([])

  /**
   * 0–100, decided automatically from what the card asks (src/lib/difficulty.ts).
   * A property of the question, not of your history with it: format,
   * how much must be produced, vocabulary density and required precision.
   * Review performance deliberately does not feed it — level, interval and
   * degradation already track that, and letting difficulty move with
   * performance would count the same signal twice and pay you more for the
   * cards you keep failing.
   * The band (Intro/Standard/Demanding/Severe) is derived on read rather
   * than stored, so recalibrating the thresholds does not require rewriting
   * every row.
   */
  difficulty Int @default(0)

  /**
   * Memory-engineering node data (src/lib/dedup.ts). Distinct from
   * `question`/`answer`, which are the *drill* — what the review session
   * shows you. These are the *node*: what this Idea asserts, used for
   * deduplication and library browsing.
   * Nullable, and left that way: every Idea predating the dedup pipeline
   * has none, and populating them retroactively would mean one Gemini call
   * per existing row. Readers must tolerate the absence — `enrichNode`
   * falls back to `question` when `corePremise` is null, and the dedup
   * reasoning strings fall back to the Idea id when `title` is null.
   */
  title        String?
  corePremise  String?
  atomicPrompt String?
  tags         String[] @default([])

  /**
   * The single attribute this Idea most exercises, inferred from its own
   * wording and question type (attribute-inference.ts).
   * A label, not a weight vector: the full composition an Idea produces is
   * folded into its Domain at creation and does not need storing per row.
   * Nullable because everything created before inference existed has none,
   * and because a submission can be too generic to call.
   */
  attribute Attribute?

  enrichments IdeaEnrichment[]

  // pgvector column — managed by raw SQL migration, not Prisma Migrate.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domainId])
  @@index([dueDate])
  @@schema("public")
}

/**
 * Append-only log of ENRICH_EXISTING merges (src/lib/dedup.ts).
 * When a candidate lands in the enrichment band it adds nuance to an Idea
 * that already exists rather than deserving its own node. The obvious
 * implementation — rewriting `Idea.corePremise` in place — silently
 * destroys the prior wording on every merge, and since the merge decision
 * is automatic there'd be no way to audit what a node used to say or undo
 * a bad call. So enrichments accumulate here instead: `Idea` keeps its
 * original premise, and the full picture is the premise plus its
 * enrichments in `createdAt` order.
 * `similarity` records the cosine score that triggered the merge, which is
 * what you need to tune thresholds against real data later.
 */
model IdeaEnrichment {
  id         String @id @default(cuid())
  ideaId     String
  idea       Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  payload    String // the new nuance, as written by the synthesis call
  sourceText String // the raw candidate text that produced it, kept for auditability
  similarity Float

  createdAt DateTime @default(now())

  @@index([ideaId])
  @@schema("public")
}

/**
 * One row per (Field, calendar day) — powers the Dashboard's "ghost" radar
 * comparison (current stats vs. 7 days ago). There's no other activity-log
 * table in this schema; rather than reconstruct history after the fact,
 * this is written forward from today via an upsert every time the
 * Dashboard is viewed (src/lib/snapshot.ts). It starts empty — a 7-day-old
 * snapshot only exists once the app has actually been open on that day.
 */
model FieldSnapshot {
  id          String   @id @default(cuid())
  fieldId     String
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  day         DateTime // truncated to UTC midnight — the calendar day this snapshot represents
  level       Float
  totalPoints Float // sum of this Field's Domains' totalPoints at snapshot time

  createdAt DateTime @default(now())

  @@unique([fieldId, day])
  @@schema("public")
}

/**
 * One Field's weighting across the thirteen attributes.
 * Weights are integers summing to 100 per Field — a percentage split of
 * what that Field trains. Modelled as rows rather than a JSON blob on
 * Field so a weight is queryable and constrained, matching how the rest of
 * this schema represents structure.
 */
model FieldAttribute {
  id        String    @id @default(cuid())
  fieldId   String
  field     Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  attribute Attribute
  weight    Int       @default(0) // 0..100; per-Field sum == 100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, attribute])
  @@index([fieldId])
  @@schema("public")
}

/**
 * Append-only mastery-point ledger.
 * Mastery points are the scarce currency skills are bought with, so the
 * balance is the sum of deltas rather than a mutable counter: spends are
 * negative rows, and every grant records what earned it. A single mutable
 * `balance` column would make an incorrect award impossible to trace or
 * reverse, and grading (see `reason`) can involve a model call whose
 * output should stay auditable.
 */
/**
 * Machine-readable `reason` values, for reference (no DB enum — this stays
 * a free string so a new income/expense source never needs a migration):
 * IDEA_MASTERED | REVIEW_FRACTION | ATTESTATION | SKILL_UNLOCK |
 * BOSS_VICTORY | DECAY.
 */
model MasteryLedgerEntry {
  id     String  @id @default(cuid())
  userId String
  /**
   * Positive to grant, negative to spend/decay. Float, not Int: every
   * successful review now mints a small fraction of a point
   * (`reviewMasteryFraction` in mastery.ts) rather than only whole points
   * on rare events, and decay debits are fractional too. The balance
   * (`sum(delta)`) is still rounded for display and truncated toward zero
   * wherever it gates a whole-number `Skill.masteryCost`.
   */
  delta  Float
  reason String
  /**
   * Free-text detail — the graded rationale, or the skill code purchased.
   */
  detail String?
  ideaId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * Per-(user, Field) Boss state — the chance-and-stakes layer over a Field's
 * hardest due material. A Boss unlocks once its Field clears
 * `BOSS_UNLOCK_LEVEL` (bosses.ts); challenging it runs a capped, themed
 * review batch through the normal SRS engine (real grading, no separate
 * game state), and only the aggregate accuracy is judged here.
 * `tier` climbs on every victory — the Boss "respawns stronger," which is
 * what makes it replayable rather than a one-time unlock. `cooldownUntil`
 * paces re-attempts (shorter after a loss, longer after a win) so this
 * reads as a periodic event to look forward to, not a grindable loop.
 */
model BossEncounter {
  id            String    @id @default(cuid())
  userId        String
  fieldId       String
  field         Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  tier          Int       @default(1)
  victories     Int       @default(0)
  lastVictoryAt DateTime?
  lastAttemptAt DateTime?
  cooldownUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

/**
 * A temporary *positive* modifier — the spoils of a Boss victory
 * (boons.ts). Mirrors `ActiveDebuff` deliberately rather than sharing a
 * table with it: the two are folded into `ActiveModifiers` by different
 * code with opposite sign conventions, and one table holding both would
 * make every read site check which kind it was looking at.
 * Boons come from a Spoils Cache. Which boon you draw is random; that a
 * victory yields one, and the mastery it pays alongside, are not — see
 * `boons.ts` for why that distinction is the whole design.
 */
model ActiveBoon {
  id        String   @id @default(cuid())
  userId    String
  /**
   * BoonKind from boons.ts, e.g. "INSIGHT" | "MOMENTUM" | "FOCUS".
   */
  kind      String
  magnitude Float
  /**
   * Machine-readable source: BOSS_SPOILS.
   */
  reason    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * A temporary negative modifier (debuffs.ts) — the inverse of an unlocked
 * skill's permanent buff. Sourced from real setbacks (losing a Boss fight,
 * a long Field streak breaking) rather than randomly, and always bounded
 * and self-expiring: nothing here ever touches `Idea`/`Domain` state, only
 * `ActiveModifiers`, so a debuff can sting without damaging the underlying
 * knowledge base.
 */
model ActiveDebuff {
  id        String   @id @default(cuid())
  userId    String
  /**
   * DebuffKind from debuffs.ts, e.g. "SHAKEN" | "FATIGUED" | "DOUBT".
   */
  kind      String
  magnitude Float
  /**
   * Machine-readable source: BOSS_DEFEAT | STREAK_BROKEN.
   */
  reason    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * Per-Field daily activity streak.
 * Distinct from the global streak derived in src/lib/streak.ts: that one
 * answers "did you show up at all", this one answers "did you keep faith
 * with *this* subject", which is what field-streak skill effects key off.
 * Stored rather than derived because it needs a per-Field last-active day
 * and `Idea.updatedAt` alone can't distinguish a review from an edit.
 */
/**
 * A Field the user has put into maintenance mode.
 * Stored as the *exception* rather than as the interest, which is what makes
 * this safe to add to a live database with no backfill: no rows means every
 * Field is of interest, exactly the behaviour that existed before this table.
 * Marking a Field inserts a row; unmarking deletes it. There is no state in
 * which the set is ambiguous or in which an empty table silently disables
 * every challenge and quota at once.
 * A maintained Field keeps reviewing normally — its Ideas come due, degrade
 * and pay out exactly as before. It is only excused the weekly new-Idea quota
 * and excluded from Boss encounters.
 */
model FieldMaintenance {
  id      String @id @default(cuid())
  userId  String
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

/**
 * Append-only capital ledger — the passive currency.
 * Deliberately a third currency with a job the other two do not do. Domain
 * points measure what a subject is worth; mastery is *earned by answering*
 * and buys new emblems. Capital accrues from what you already hold, whether
 * or not you show up, and is only ever spent deepening emblems you own. So
 * the three never compete for the same decision.
 * Append-only for the same reason `MasteryLedgerEntry` is: a balance that is
 * the sum of its history can be audited and replayed, where a mutable
 * counter silently loses the reason it changed.
 */
model CapitalLedgerEntry {
  id     String  @id @default(cuid())
  userId String
  /**
   * Positive for a claimed dividend, negative for an augment purchase.
   */
  delta  Float
  /**
   * DIVIDEND | AUGMENT | ADJUSTMENT
   */
  reason String
  detail String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason])
  @@schema("public")
}

/**
 * A permanent upgrade burned onto an emblem the user already owns.
 * Keyed by `skillCode` rather than by `UnlockedSkill.id` so an augment
 * survives any future re-issue of the unlock row, and unique per kind so the
 * same emblem cannot be sold the same upgrade twice.
 */
model EmblemAugment {
  id        String @id @default(cuid())
  userId    String
  skillCode String
  /**
   * AugmentKind from augments.ts: AMPLIFY | GRAFT | YIELD | PRESTIGE
   */
  kind      String
  /**
   * Capital actually burned — recorded so a future rebalance can refund honestly.
   */
  costPaid  Float  @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, skillCode, kind])
  @@index([userId])
  @@schema("public")
}

model FieldStreak {
  id            String   @id @default(cuid())
  userId        String
  fieldId       String
  field         Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  currentDays   Int      @default(0)
  bestDays      Int      @default(0)
  lastActiveDay DateTime // truncated to UTC midnight

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

model UnlockedSkill {
  id           String   @id @default(cuid())
  userId       String
  skillCode    String
  usesThisWeek Int      @default(0)
  weekAnchor   DateTime @default(now()) // start of the week usesThisWeek is counted against

  /**
   * Mastery points actually spent to unlock — recorded so a future rebalance can refund honestly.
   */
  masteryPaid Int      @default(0)
  unlockedAt  DateTime @default(now())

  /**
   * Loadout slot, 0..9, or null when benched.
   * Owning a skill no longer makes it do anything: only the ten equipped
   * skills fold into `ActiveModifiers`. Unlocking used to be the last
   * decision a player ever made about a skill — with 749 of them and no
   * cap, a long-running account would simply hold every effect at once and
   * the whole tree would collapse into "buy everything". A hard ten-slot
   * bench turns each unlock into an ongoing choice about what to carry.
   * Uniqueness is per (userId, slot), so a slot holds at most one skill;
   * equipping into an occupied slot swaps rather than stacks.
   */
  equippedSlot Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillCode])
  @@unique([userId, equippedSlot])
  @@schema("public")
}

// ── Life: one day clock, one ledger, graded tasks (migration life_core) ─────
//
// The life system extends the knowledge game to the rest of a day: todos,
// habits, compulsory duties, goals, and (later) workouts. Its rules live in
// src/lib/life-*.ts. Everything here is additive: no existing table is
// altered, kinds and reasons are TEXT typed by TS unions, and every "life
// day" column holds the local calendar date that src/lib/life-day.ts
// `dateColumn` produces (a day turns over at 04:00 local).

/// Per-user life settings. Created lazily on the first capture.
model LifeSettings {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// The first life day. Nothing earlier ever pays XP.
  epochDay          DateTime  @db.Date
  dailyCapacityMin  Int       @default(240)
  /// When the player chose dailyCapacityMin. Null: it is still the default, and the Today tile may not warn against it.
  capacitySetAt     DateTime?
  /// 1 = Mon … 7 = Sun: standing rest days (used from M2).
  restWeekdays      Int[]     @default([])
  /// The last life day settlement has judged (M2).
  settledThroughDay DateTime? @db.Date
  /// "Accept the loss" on old debt. Off: debt stays until it is done.
  debtWriteOff      Boolean   @default(false)
  hrMax             Int?
  birthYear         Int?
  /// Unmapped tracker activity code -> exercise kind (M4).
  activityMap       Json?
  /// Per-track weekly targets (M5).
  weeklyTargets     Json?
  /// Roadmap revision 4: "Suggest setting an aim". false is the lasting no; true or null (the default) is on.
  aimSuggestions    Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("public")
}

/// THE append-only life ledger. Every action lands here once: a review, a new
/// Idea, a completed task, an undo, a debt. `sink` says where its XP counts:
/// DOMAIN rows only record points srs.ts / ideas.ts already credited to a
/// Domain (so knowledge is never paid twice), TRACK rows are the life XP, and
/// NONE rows are records. Life levels read only SUM(xp) WHERE sink = 'TRACK'.
/// The daily streak, habit strength and levels are derived from these rows on
/// read; nothing here is a mutable counter. Corrections are new rows.
model ActivityEvent {
  id              String   @id @default(cuid())
  userId          String
  day             DateTime @db.Date
  occurredAt      DateTime
  /// REVIEW, IDEA_CREATE, TASK, UNDO, DAY_OPEN, … (src/lib/life-types.ts).
  source          String
  /// DOMAIN | TRACK | NONE.
  sink            String   @default("NONE")
  /// BODY | DUTY | CRAFT | CARE, for TRACK rows.
  track           String?
  templateId      String?
  /// The Idea / TaskInstance / Workout this row is about. No FK, like MasteryLedgerEntry.ideaId.
  sourceId        String?
  compositionKey  String?
  /// XP paid, after the daily knee.
  xp              Float    @default(0)
  /// XP before the knee; the day's knee base is SUM(rawXp).
  rawXp           Float?
  qty             Float?
  countsForStreak Boolean  @default(false)
  /// The published price breakdown: {v, factors[], raw, kneeBefore, xp, track}.
  receipt         Json?
  detail          String?
  /// Makes automatic writes idempotent ("task:<tpl>:<day>:<slot>:<n>", "dayopen:<day>", …). NULLs allowed.
  dedupeKey       String?
  createdAt       DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, day])
  @@index([userId, source, day])
  @@index([userId, track, day])
  @@index([userId, templateId, day])
  @@index([userId, sourceId])
  @@schema("public")
}

/// A task, habit, duty or goal: the rule it follows and its frozen grade.
/// "AI sizes once, formula scores": a lexical grade is written at capture,
/// Gemini may refine it once within 24 h, and the grade freezes at the first
/// completion. Templates with history are archived, never deleted.
model TaskTemplate {
  id                 String         @id @default(cuid())
  userId             String
  title              String
  /// Lowercase, parse tokens, digits and stop-words stripped: the repeat-decay and grade-copy key.
  normTitle          String
  /// The original capture line, for audit and re-parse.
  rawText            String
  note               String?
  /// TASK | HABIT | GOAL | IDEA_DRAFT.
  kind               String
  inbox              Boolean        @default(false)
  /// DAILY | WEEKDAYS | DOW:1,4 | EVERY:3 | AFTER:3 | TARGET:3/W | TARGET:2/M | MONTHLY:15 (src/lib/recurrence.ts).
  recurrence         String?
  startDay           DateTime       @db.Date
  dueDay             DateTime?      @db.Date
  /// PLANNED (carries forward, never late) | DEADLINE (late after it).
  dueKind            String?
  /// A one-off put off to this life day ('Move to tomorrow' on a deadline): off the board until then. Never moves dueDay or the late factor.
  planDay            DateTime?      @db.Date
  /// SHORT | MID | LONG, for goals.
  horizon            String?
  parentId           String?
  parent             TaskTemplate?  @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           TaskTemplate[] @relation("GoalTree")
  /// CHILDREN | MANUAL | REVIEWS | IDEAS | WORKOUTS | RUN_KM.
  krMetric           String?
  krTarget           Float?
  krUnit             String?
  /// Mastery points a goal pays, frozen when stated (M5).
  goalMp             Float?
  closedScore        Float?
  compulsory         Boolean        @default(false)
  compulsoryOnRest   Boolean        @default(false)
  /// #play: logged and streak-counting, pays 0.
  intrinsic          Boolean        @default(false)
  /// The minimum viable version, e.g. "10 pushups".
  mvv                String?
  mvvMinutes         Int?
  /// REVIEWS | IDEAS | REVIEW_DUE | STEPS | WORKOUT: completes itself from activity. PAGES (blueprint P24, decision D21):
  /// a reading task ticked by hand, its day's pages target in autoTarget (src/lib/proof.ts; TEXT with no CHECK, so the
  /// value needed no SQL).
  autoMetric         String?
  autoTarget         Float?
  autoFamily         String?
  /// BODY | DUTY | CRAFT | CARE.
  track              String
  /// CATEGORY | TAG.
  trackSource        String         @default("CATEGORY")
  category           String
  /// The machine band after the merge: INTRO | STANDARD | DEMANDING | SEVERE.
  band               String
  lexicalBand        String
  aiBand             String?
  /// Self-rating, −3..+1 steps; never above machine + 1.
  bandOverride       Int            @default(0)
  bandOverrideAt     DateTime?
  estMinutes         Int
  machineMinutes     Int
  /// USER | AI | LEXICAL.
  minutesSource      String
  /// Record<Attribute, int> summing to 100; a frozen snapshot.
  composition        Json
  /// LEXICAL | AI | COPIED.
  gradeSource        String
  gradeConfidence    Float
  gradeBasis         String?
  gradeModel         String?
  gradePromptVersion Int?
  gradeAttempts      Int            @default(0)
  aiGradedAt         DateTime?
  gradeCopiedFrom    String?
  gradeFrozenAt      DateTime?
  /// A weakening change waiting out its delay (M2).
  pendingChange      Json?
  pendingChangeAt    DateTime?
  /// quick | share | api | form.
  captureSource      String         @default("quick")
  /// The capture sheet's per-line nonce: a retried save finds the row it already wrote instead of writing a second.
  captureKey         String?
  sortOrder          Float          @default(0)
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  instances          TaskInstance[]
  /// Work boards (2026-10-12): the work tab this task lives on; null = the personal Board. A work task never pays life XP or
  /// counts for streaks, kept weeks, tracks, goals or quests (work is kept separate from the game, the user's choice).
  boardId            String?
  board              WorkBoard?     @relation(fields: [boardId], references: [id], onDelete: Restrict)
  callBacks          CallBack[]
  /// Deferred (2026-10-13, migration 20261222000000_task_defer_abort): off the board until this instant, then back.
  deferUntil         DateTime?
  decisions          TaskDecision[]
  /// Skills (blueprint P5, migration 20261230000000_competencies): the Competency this task's ticks count toward; null =
  /// none (every row before P5: it behaves exactly as before). A plain id, no foreign key (a link to a skill archived or
  /// gone counts toward nothing). Never on a work tab's task (competency-server refuses it). Hours are read, not stored.
  competencyId       String?
  /// Proof of work (blueprint P23, decision D20; migration 20270101000000_task_proof): 'MINUTES' = the task counts its
  /// time (a full tick needs its minutes or a timer, from PROOF_LAUNCH_DAY: src/lib/proof.ts); null = none (every row
  /// before P23). Set by the '#proof' capture tag, or for the default deep-work set once the user approves the dry-run
  /// list (scripts/proof-dry-run.ts). Not expressible in Prisma 6: CHECK "TaskTemplate_proof_check" (null or MINUTES).
  proof              String?

  @@unique([userId, captureKey])
  @@index([userId, archivedAt])
  @@index([userId, boardId])
  @@index([userId, normTitle])
  @@index([userId, competencyId])
  @@index([parentId])
  @@schema("public")
}

/// One occurrence of a template, materialised only when it is acted on or
/// judged. Expected occurrences are a pure function of the rule and the day
/// (src/lib/recurrence.ts) and are never pre-created. Its status is a
/// projection of the ledger.
model TaskInstance {
  id          String       @id @default(cuid())
  userId      String
  templateId  String
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  day         DateTime     @db.Date
  /// "Again" completions use slot n + 1.
  slot        Int          @default(0)
  /// DONE | DONE_LATE | DONE_MVV | MISSED | EXCUSED | SKIPPED | UNDONE | WRITTEN_OFF | MADE_UP (M2: a late make-up; the debt is cleared, the occurrence still reads missed).
  status      String
  /// manual | record-yesterday | make-up | auto:reviews | auto:ideas | auto:steps | auto:workout.
  source      String       @default("manual")
  completedAt DateTime?
  minutes     Int?
  rpe         Int?
  xpPaid      Float        @default(0)
  debtXp      Float        @default(0)
  debtOpen    Boolean      @default(false)
  repaired    Boolean      @default(false)
  judgedAt    DateTime?
  workoutId   String?
  /// Pages proof (blueprint P24, decision D21; migration 20270102000000_proof_qty): what proofQty counts, 'PAGES' (a
  /// reading task's tick, from PROOF_LAUNCH_DAY: src/lib/proof.ts); null on every other instance. A record, never a
  /// price. Not expressible in Prisma 6: CHECK "TaskInstance_proofKind_check" (null or PAGES) and CHECK
  /// "TaskInstance_proof_pair_check" (proofKind and proofQty both set, or neither).
  proofKind   String?
  /// The pages the tick reported (whole, 1 to 2000); null with none. Not expressible in Prisma 6: CHECK
  /// "TaskInstance_proofQty_check" (null, or above 0 and at most 2000).
  proofQty    Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([templateId, day, slot])
  @@index([userId, day])
  @@index([userId, debtOpen])
  @@schema("public")
}

/// A declared rest, sick or vacation day (M2, migration life_duty). Read only
/// through src/lib/duty-rule.ts heldDaysOf, which ignores a REST or VACATION
/// row declared at or after its day started, a SICK row declared at or after
/// its day ended, and any cancelled row. Every write upserts by (userId, day)
/// and resets kind, declaredAt and cancelledAt, so a reused row is judged by
/// its new declaration time.
model RestDay {
  id          String    @id @default(cuid())
  userId      String
  /// The life day held (life-day.ts dateColumn).
  day         DateTime  @db.Date
  /// REST | SICK | VACATION.
  kind        String
  declaredAt  DateTime  @default(now())
  /// A future declaration can be cancelled before its day starts; the row is reused by the next declaration.
  cancelledAt DateTime?

  @@unique([userId, day])
  @@schema("public")
}

// ── Celebrations: persisted Seals and Ascensions (migration celebrations) ────
//
// The reward ladder's two loud tiers (redesign.md › Rewards). Detectors in
// src/lib/celebrations.ts diff a before and an after snapshot of progress and
// write each Seal (T2) or Ascension (T3) here once, keyed by an idempotent
// dedupeKey, so a moment plays once across the Fold and the desktop. T0 and T1
// render in place and are never stored. Additive: new tables only, kinds are
// TEXT typed by src/lib/celebration-types.ts, and nothing has a foreign key.

/// One Seal (tier 2) or Ascension (tier 3). Acknowledging sets shownAt; an
/// unseen row surfaces on the next open. You › Moments lists them.
model CelebrationEvent {
  id         String    @id @default(cuid())
  userId     String
  /// 2 = Seal, 3 = Ascension.
  tier       Int
  /// A T2/T3 kind from celebration-types.ts: 'domain-level', 'band', 'emblem-unlock', …
  kind       String
  /// Idempotency, one row per key per user, ever: 'title:Practitioner', 'band:bronze', 'domain:<id>:7', 'streak:30', 'unlock:<code>', …
  dedupeKey  String
  /// CelebrationFacts: eyebrow, title, fact lines, exact amounts, numeral, material, and the T3 text.
  facts      Json
  /// WhatMoved[]: label left, exact value right.
  what       Json      @default("[]")
  /// Set when a louder event from the same diff claimed this key (the level-15 re-forge claims 'title:Practitioner' and 'level:15'). Such a row never plays and is not a Moment.
  mergedInto String?
  createdAt  DateTime  @default(now())
  /// When a device first showed it. Null: still pending.
  shownAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, shownAt])
  @@index([userId, createdAt])
  @@schema("public")
}

/// Settings › Feedback, persisted for the account (savePrefs). theme, motion and
/// autoAdvance follow the account across devices; sound and haptics are per
/// device (the localStorage mirror). Every column is nullable on purpose: null
/// means "never chosen", so a device that saved only its theme never imposes a
/// default motion on another device that chose Still.
model UserPrefs {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// night | vellum
  theme       String?
  /// system | full | calm | still
  motion      String?
  /// off | soft (per device; normally null)
  sound       String?
  /// off | on (per device; normally null)
  haptics     String?
  /// next | wait
  autoAdvance String?
  /// on | off; null = on. The evening momentum push (momentum.md §F; migration 20261220000000_momentum).
  nudge       String?
  /// A cosmetic id from momentum.ts COSMETICS; null = the default flame (momentum.md §A.2).
  flameSkin   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

// ── Body weight ────────────────────────────────────────────────────────────
// A record, never a reward: no reading pays XP or MP, and nothing in the
// economy reads these tables. Kept in kilograms; the unit is display only.
// src/lib/weight.ts holds the rules (trend, rate, projection), and
// src/lib/weight-server.ts the reads and writes.

/// One weigh-in per life day: logging again that day replaces it.
model BodyWeight {
  id         String   @id @default(cuid())
  userId     String
  /// The life day (src/lib/life-day.ts dateColumn): a 01:00 weigh-in counts for the day before.
  day        DateTime @db.Date
  /// Kilograms, two decimals.
  kg         Decimal  @db.Decimal(6, 2)
  /// When it was logged (or measured, for an import).
  measuredAt DateTime @default(now())
  /// manual | capture | import
  source     String   @default("manual")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
  @@schema("public")
}

/// The weight goal and the unit weights are shown in. One row per user.
model WeightGoal {
  id        String    @id @default(cuid())
  userId    String    @unique
  /// kg | lb (display only; readings are stored in kg).
  unit      String    @default("kg")
  /// The target, in kg. Null: no target set, the card shows the trend only.
  targetKg  Decimal?  @db.Decimal(6, 2)
  /// An optional date to reach it by (a life day).
  targetDay DateTime? @db.Date
  /// The trend weight when the target was set: the bar measures progress from here.
  startKg   Decimal?  @db.Decimal(6, 2)
  /// When the target was set (a life day).
  startDay  DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("public")
}

// ── Exercise and task style (migration life_exercise_style) ────────────────
// Additive: two new tables, no existing table altered, no foreign keys. Both
// are records, never rewards: nothing in the economy reads them.
// src/lib/exercise-server.ts and src/lib/task-style-server.ts read them fail
// soft (a missing table reads as nothing logged / no style).
// Migration 20270104000000_strength_sets (health-2026-10-27.md D10, D11) adds
// ten nullable columns to ExerciseSession, the one header for every kind. A
// walk pays as before (momentum.md §A.6, its 'walk-1' receipt); every other
// kind is a record until SESSION_PAY_LAUNCH_DAY (src/lib/exercise.ts, null).
// Every read and write of the table names its columns (a build that predates
// the migration never asks for a new one).

/// One exercise session on Train › Exercise, of any kind (src/lib/exercise.ts EXERCISE_KINDS). A kind with no
/// distance (HIIT, SPORT, YOGA, MOBILITY, LIFT, …) stores distanceKm 0 (D11). A live LIFT carries its wall clock
/// (startedAt, endedAt). A plain userId with no foreign key; a session's delete removes its ExerciseEntry and
/// ExerciseSet rows in the same transaction.
/// Not expressible in Prisma 6: CHECK "ExerciseSession_variant_check" (null or an upper-case key, 1..24 characters),
/// CHECK "ExerciseSession_label_check" (null or 1..40 characters), CHECK "ExerciseSession_ended_check" (endedAt null, or
/// startedAt set and endedAt at or after it), CHECK "ExerciseSession_avgHr_check" (null or 30..250), CHECK
/// "ExerciseSession_maxHr_check" (null or 30..250), CHECK "ExerciseSession_hr_check" (maxHr at or above avgHr), CHECK
/// "ExerciseSession_avgWatts_check" (null or 1..2000), CHECK "ExerciseSession_poolM_check" (null or 10..100), CHECK
/// "ExerciseSession_sessionRpe_check" (null or 0..10), CHECK "ExerciseSession_clientId_check" (null or 1..64
/// characters), and partial UNIQUE "ExerciseSession_userId_open_key" (userId) WHERE startedAt IS NOT NULL AND endedAt
/// IS NULL (one open session a user). No CHECK on kind: the core holds EXERCISE_KINDS.
model ExerciseSession {
  id          String    @id @default(cuid())
  userId      String
  /// The life day (src/lib/life-day.ts dateColumn).
  day         DateTime  @db.Date
  /// WALK | RUN | CYCLE | SWIM | ROW | ELLIPTICAL | HIIT | CIRCUIT | SPORT | YOGA | MOBILITY | LIFT (exercise.ts EXERCISE_KINDS).
  kind        String    @default("WALK")
  /// The incline in degrees (0 = flat), as the user set it (a walk, a run).
  angleDeg    Float     @default(0)
  /// Kilometres; 0 for a kind with no distance.
  distanceKm  Float
  durationMin Float
  note        String?
  createdAt   DateTime  @default(now())
  /// The kind's variant (exercise.ts KIND_SPECS: RUN TREADMILL, CYCLE SPIN, SWIM BREAST, SPORT TENNIS, YOGA VINYASA, …).
  variant     String?
  /// The user's name for it, 1..40 characters ("Push day"; the sport of a SPORT OTHER).
  label       String?
  /// A live session's wall clock: started, and ended (null while open).
  startedAt   DateTime? @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)
  /// Beats a minute, 30..250.
  avgHr       Int?      @db.SmallInt
  maxHr       Int?      @db.SmallInt
  /// 1..2000 W.
  avgWatts    Int?      @db.SmallInt
  /// A swim's pool length, 10..100 m; null for open water.
  poolM       Float?    @db.Real
  /// "How hard was it?" 0..10 (CR10): a record only, never priced.
  sessionRpe  Int?      @db.SmallInt
  /// A save's key: a resend answers the row it wrote, once.
  clientId    String?

  @@unique([userId, clientId])
  @@index([userId, day])
  @@schema("public")
}

/// A task's or habit's icon and colour, chosen by the user (src/lib/task-style.ts names them). One row per template.
model TaskStyle {
  templateId String   @id
  userId     String
  /// A TASK_ICONS name.
  icon       String?
  /// A TASK_COLORS name.
  color      String?
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

// ── Strength sets (migration 20270104000000_strength_sets; health-2026-10-27.md D12, D14-D18) ──
// The lift logger: a LIFT ExerciseSession holds its movements in order (ExerciseEntry), each with its sets
// (ExerciseSet); a movement the user adds is a UserMovement (the starter library lives in code,
// src/lib/training-library.ts STARTER_MOVEMENTS, never seeded). A record, never a reward: nothing in the economy reads
// these tables, and no set (or any load, rep count, RIR or record derived from one) pays or costs XP, MP, a streak day,
// a quest, a kept week, a skill hour, a side-quest input, a Mall credit or a calibration input; strength PR Seals carry
// no XP (D14). Kilograms are stored, the unit is display only (WeightGoal.unit). Set count, volume, the top set, the
// heaviest weight, e1RM, rep maxes and hard sets per muscle are derived on read, never stored. Plain TEXT ids with no
// foreign key; every timestamp is timestamptz.

/// A movement the user adds: its name (1..40 characters) and normal form (training-library.ts normNameOf; one live
/// movement per name), pattern, equipment, primary (1..4) and secondary (0..6) muscles in the free-exercise-db
/// vocabulary, how its load is read (EXT the total, PAIR one of two implements, ONE a single implement, BW a body
/// fraction plus a signed added load, TIME a hold, CARRY a load carried), whether it is done one side at a time, its
/// weight step and its rest. Archived, never deleted: a set logged with it keeps its key ('u:' and this id).
/// Not expressible in Prisma 6: CHECK "UserMovement_name_check" (1..40 characters), CHECK "UserMovement_normName_check"
/// (1..40 characters), CHECK "UserMovement_pattern_check" (the ten PATTERNS), CHECK "UserMovement_equipment_check" (the
/// nine EQUIPMENT), CHECK "UserMovement_primary_check" (1..4 of the 17 MUSCLES), CHECK "UserMovement_secondary_check"
/// (at most 6 of the 17 MUSCLES), CHECK "UserMovement_load_check" (EXT | PAIR | ONE | BW | TIME | CARRY), CHECK
/// "UserMovement_bodyFraction_check" (null, or 0.05..1 on a BW movement), CHECK "UserMovement_stepKg_check" (null or
/// 0.25..25), CHECK "UserMovement_restSec_check" (null or 0..600), "primaryMuscles" and "secondaryMuscles" NOT NULL,
/// and partial UNIQUE "UserMovement_userId_normName_live_key" (userId, normName) WHERE archivedAt IS NULL.
model UserMovement {
  id               String    @id @default(cuid())
  userId           String
  name             String
  /// training-library.ts normNameOf(name): lower case, letters, digits and single spaces.
  normName         String
  /// SQUAT | HINGE | LUNGE | PUSH_H | PUSH_V | PULL_H | PULL_V | CARRY | CORE | ISOLATION (training-library.ts PATTERNS).
  pattern          String
  /// BARBELL | DUMBBELL | KETTLEBELL | MACHINE | CABLE | EZ_BAR | BODY | BAND | OTHER (training-library.ts EQUIPMENT).
  equipment        String
  /// free-exercise-db muscle names (training-library.ts MUSCLES): 1..4.
  primaryMuscles   String[]  @default([])
  /// 0..6, none of them primary.
  secondaryMuscles String[]  @default([])
  /// EXT | PAIR | ONE | BW | TIME | CARRY (training-library.ts LOAD_KINDS).
  load             String    @default("EXT")
  /// A BW movement's share of body weight (1.0 a pull-up, 0.65 a push-up); null: reps only.
  bodyFraction     Float?    @db.Real
  /// Reps are logged per side, both sides done.
  unilateral       Boolean   @default(false)
  /// The weight step in kg (2.5 a barbell, 2 a dumbbell, 5 a machine); null: the equipment's.
  stepKg           Float?    @db.Real
  /// Seconds of rest after a working set; null: the pattern's default.
  restSec          Int?
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  /// The picker's read: a user's movements.
  @@index([userId])
  @@schema("public")
}

/// One movement in a LIFT session, in order (1..50), so "Repeat Push day" and the phone's "Next: Bench" exist before
/// any set. movementKey is a library key (training-library.ts STARTER_MOVEMENTS) or 'u:' and a UserMovement id;
/// groupNo joins a superset or a circuit; bodyKg is the BodyWeight reading it was logged against (that day's, else the
/// latest before it), a snapshot for BW loads (null: reps only).
/// Not expressible in Prisma 6: CHECK "ExerciseEntry_movementKey_check" (a library key or 'u:' and an id), CHECK
/// "ExerciseEntry_ord_check" (1..50), CHECK "ExerciseEntry_groupNo_check" (null or 1..50), CHECK
/// "ExerciseEntry_bodyKg_check" (null or 20..400, weight.ts MIN_KG..MAX_KG), and CHECK "ExerciseEntry_note_check" (null
/// or 1..200 characters).
model ExerciseEntry {
  id          String   @id @default(cuid())
  userId      String
  /// The LIFT ExerciseSession it belongs to (a plain id).
  sessionId   String
  movementKey String
  ord         Int      @db.SmallInt
  groupNo     Int?     @db.SmallInt
  bodyKg      Decimal? @db.Decimal(6, 2)
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  /// A session's read (its movements in order) and its delete.
  @@index([sessionId])
  /// "Last time" for a movement.
  @@index([userId, movementKey])
  @@schema("public")
}

/// One "Set done", one idempotent insert keyed by clientId (the phone's queue replays safely). ord is its place in the
/// entry (1..100). kind is WARMUP | WORKING | DROP | MINI (rest-pause); a DROP or MINI names the head set it continues
/// (chainOf, an earlier ord), and chainOf is null exactly on a WARMUP or WORKING set. weightKg is EXT the total, PAIR
/// and ONE one implement, BW the signed added load (−20: 20 kg of assistance). rir 0..5 (5 is "4+"); toFailure means
/// RIR 0 and is never on a warm-up; amrap is a working set's target. durationSec is a hold, distanceM a carry, restSec
/// the rest the timer gave it (never typed). movementKey and day (the session's life day) are copied from the entry and
/// the session for the history reads.
/// Not expressible in Prisma 6: CHECK "ExerciseSet_movementKey_check" (a library key or 'u:' and an id), CHECK
/// "ExerciseSet_ord_check" (1..100), CHECK "ExerciseSet_kind_check" (WARMUP | WORKING | DROP | MINI), CHECK
/// "ExerciseSet_chainOf_check" (null, or 1..ord − 1), CHECK "ExerciseSet_chain_check" (chainOf null exactly on WARMUP and
/// WORKING), CHECK "ExerciseSet_weightKg_check" (null or −200..500), CHECK "ExerciseSet_reps_check" (null or 1..100),
/// CHECK "ExerciseSet_rir_check" (null or 0..5), CHECK "ExerciseSet_flags_check" (toFailure: not a warm-up, RIR null or
/// 0; amrap: WORKING only), CHECK "ExerciseSet_durationSec_check" (null or 1..3600), CHECK "ExerciseSet_distanceM_check"
/// (null or over 0 to 10000), CHECK "ExerciseSet_restSec_check" (null or 0..3600), CHECK "ExerciseSet_measure_check"
/// (reps, durationSec or distanceM set), and CHECK "ExerciseSet_clientId_check" (1..64 characters).
model ExerciseSet {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  entryId     String
  movementKey String
  /// The session's life day (src/lib/life-day.ts dateColumn).
  day         DateTime @db.Date
  ord         Int      @db.SmallInt
  /// WARMUP | WORKING | DROP | MINI (training-library.ts SET_KINDS).
  kind        String   @default("WORKING")
  chainOf     Int?     @db.SmallInt
  weightKg    Decimal? @db.Decimal(6, 2)
  reps        Int?     @db.SmallInt
  rir         Int?     @db.SmallInt
  toFailure   Boolean  @default(false)
  amrap       Boolean  @default(false)
  durationSec Int?
  distanceM   Float?   @db.Real
  restSec     Int?
  doneAt      DateTime @db.Timestamptz(3)
  clientId    String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, clientId])
  /// An entry's sets in order.
  @@index([entryId])
  /// A session's read and its delete.
  @@index([sessionId])
  /// A movement's history over a span of life days.
  @@index([userId, movementKey, day])
  @@schema("public")
}

// ── Mind: the 5-second check-in (migration 20270103000000_mind_checks; health-2026-10-27.md D1, D5, D8) ──
// A record, never a reward: nothing in the economy reads these tables, and no check-in (or any value it holds) pays
// XP, MP, a streak day, a quest, a side-quest input, a Mall credit or a calibration input. No check-in is an
// ActivityEvent, so the 'life' reset never deletes one (as it never deletes a weigh-in) and each one can be deleted on
// its own. src/lib/mind.ts holds the rules (the grid, the words, the trend, the low pattern, the safety lines);
// src/lib/mind-server.ts is their only reader and writer, fail soft. A check-in, a pause and a hide wait for
// MIND_LAUNCH_DAY (null in code); the deletes never do (the user can always remove what was recorded). Values never go
// into a URL, a push payload, /check, the widget, a log line or Gemini.

/// One check-in: one tap on the 9×9 pleasantness × energy grid (valence and energy, −4..+4 each), then an optional
/// stress rating (0..4: Not at all, A little, Some, Quite a lot, Very much), feeling word and up to 8 tags. Many a day,
/// keyed by instant and clientId (a resend answers the row it wrote). A plain userId with no foreign key. Every
/// timestamp is timestamptz.
/// Not expressible in Prisma 6: CHECK "MoodCheck_valence_check" (−4..4), CHECK "MoodCheck_energy_check" (−4..4), CHECK
/// "MoodCheck_stress_check" (null or 0..4), CHECK "MoodCheck_word_check" (null or 1..24 characters), CHECK
/// "MoodCheck_tags_check" (at most 8), CHECK "MoodCheck_trigger_check" (prompted | self | close), CHECK
/// "MoodCheck_via_check" (the eight surfaces), CHECK "MoodCheck_tookMs_check" (null or 0..600000), CHECK
/// "MoodCheck_clientId_check" (1..64 characters), and "tags" NOT NULL.
model MoodCheck {
  id         String    @id @default(cuid())
  userId     String
  /// The life day it was felt on (src/lib/life-day.ts dateColumn of `at`): a 01:00 check-in counts for the day before.
  day        DateTime  @db.Date
  /// The instant it was felt (a queued phone send keeps its own).
  at         DateTime  @db.Timestamptz(3)
  /// Pleasantness, −4..+4 (mind.ts GRID_MIN..GRID_MAX).
  valence    Int       @db.SmallInt
  /// −4..+4.
  energy     Int       @db.SmallInt
  /// 0..4 (mind.ts STRESS_LEVELS); null when skipped.
  stress     Int?      @db.SmallInt
  /// An optional feeling word, at most 24 characters (mind.ts WORD_MAX).
  word       String?
  /// Up to 8 context tags (mind.ts TAGS_MAX, DEFAULT_TAGS).
  tags       String[]  @default([])
  /// prompted | self | close (mind.ts CHECK_TRIGGERS).
  trigger    String    @default("self")
  /// web | today | check | widget | tile | notify | capture | close (mind.ts CHECK_VIAS).
  via        String    @default("web")
  /// When the prompt it answered was shown; null when it was not prompted.
  promptedAt DateTime? @db.Timestamptz(3)
  /// Opening the sheet to saving it, 0..600000 ms (the 5-second claim, measured); null when not measured.
  tookMs     Int?
  clientId   String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([userId, clientId])
  /// The Mind view's read: a user's check-ins over a span of life days.
  @@index([userId, day])
  /// The latest check-in's read.
  @@index([userId, at])
  @@schema("public")
}

/// One row a user: the pause (check-ins resume on pausedUntil, a life day; null: not paused) and when the low-pattern
/// card was last hidden (once hidden, it stays hidden 7 days; null: never hidden). "Delete all check-ins" clears
/// lowSeenAt and keeps the pause.
model MindPrefs {
  userId      String    @id
  pausedUntil DateTime? @db.Date
  lowSeenAt   DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@schema("public")
}

// ── Question variants (migration idea_question_variants) ──────────────────
// Additive: one new table, no existing table altered, no foreign keys. Other
// wordings of an idea's question (same answer); a review shows one of them,
// or the original, picked at random (src/lib/idea-variants.ts). Read fail
// soft: a missing table reads as no variants. Never read by dedup, the
// embedding or difficulty: those keep the original question.

/// Another way to ask an idea's question: the prompt only (SHORT, FORMULA: the whole question; LIST, ORDER, NUMERIC: its prompt).
model IdeaVariant {
  id        String   @id @default(cuid())
  ideaId    String
  /// Its place in the idea's list, from 0.
  ord       Int
  prompt    String
  createdAt DateTime @default(now())

  @@index([ideaId])
  @@schema("public")
}

// ── Subtasks (migration life_subtasks) ─────────────────────────────────────
// Additive: two new tables, no existing table altered, no foreign keys. A task
// or habit has no steps until the user adds them in its drawer; ticking steps
// pays a share of the task's own price through its one TASK row (re-priced on
// each change; src/lib/subtasks-server.ts). Read fail soft: a missing table
// reads as no steps.

/// One step of a task or habit, added by the user in the task drawer. Removed steps keep their row (archivedAt).
model TaskSubtask {
  id         String    @id @default(cuid())
  userId     String
  templateId String
  /// The step's place in its list, from 0.
  ord        Int
  title      String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([templateId])
  @@index([userId])
  @@schema("public")
}

/// A step ticked on a life day. One row per step per day.
model TaskSubtaskTick {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  subtaskId  String
  /// The life day (src/lib/life-day.ts dateColumn).
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([subtaskId, day])
  @@index([userId, day])
  @@index([templateId, day])
  @@schema("public")
}

// ── Roadmap: an Aim, its drafts, milestones, measures and week quests ─────
// (migration life_roadmap; docs/life-plan/roadmap.md revision 3, F1)
//
// An Aim the user writes, the structure Gemini (or the app) drafts for it,
// the milestones the user accepts and starts, the measures code sets, the
// readings code writes forward one life day at a time, the acceptance log,
// and each life week's frozen week quests. Additive: eight new tables, no
// existing table is altered, and the only foreign keys run between these
// tables. Field, Domain, Idea and TaskTemplate are referenced by plain TEXT
// ids and read tolerantly (a removed row reads "Domain removed"). Status and
// kind columns are TEXT, typed by the unions in src/lib/roadmap-types.ts.
// Nothing here pays: a started milestone becomes an ordinary MID goal
// (TaskTemplate krMetric 'ROADMAP'), and only GOAL_RULES pay it.

/// One Aim. At most one DRAFT or ACTIVE per user (a claim-first guard under
/// pg_advisory_xact_lock(hashtext('roadmap:' || userId))).
model Roadmap {
  id                 String              @id @default(cuid())
  userId             String
  /// The user's words, shown verbatim everywhere and never rewritten (at most 140 characters).
  aim                String
  /// The Area Field; null for a life-track Area (a practice-only aim).
  fieldId            String?
  /// The Domains the user chose at intake (plain ids; no foreign key).
  domainIds          String[]            @default([])
  /// CRAFT | BODY | CARE | DUTY: the track the practices count toward.
  track              String              @default("CRAFT")
  /// The life day the plan starts (the intake day).
  startDay           DateTime            @db.Date
  /// The aim's date, at most SPAN_MAX_DAYS (1,080) after startDay.
  targetDay          DateTime            @db.Date
  hoursPerWeek       Int
  /// YOURS, asked only when no pace is measured. Null: new cards are not counted until a pace is measured.
  newCardsPerWeek    Int?
  /// YOURS "hours this usually takes" (the aim check), with its source note.
  typicalHours       Int?
  typicalHoursSource String?
  /// YOURS: {lines: string[], source: string | null}.
  syllabus           Json?
  /// NEW | BASICS | WORKING | STRONG.
  startPoint         String
  /// LIGHT | STEADY | PUSH.
  intensity          String              @default("STEADY")
  practicesAllowed   Boolean             @default(true)
  constraints        String?
  examLabel          String?
  /// Revision 4: the aim's depth, the gate level of its final stage (12 Mastered, 10 Fluent, 8 Retained). Null on a track Area and on a plan made before revision 4 (legacy).
  depth              Int?
  /// Revision 4: REALISTIC (the app dates the plan; only on a DRAFT) or CHOSEN.
  dateMode           String              @default("CHOSEN")
  /// Revision 4: YOURS coverage overrides, {[domainId]: number} (only figures the user typed).
  coverage           Json?
  /// Revision 4: "Let Gemini suggest areas" (read only while ROADMAP_GAPS_LIVE).
  suggestAreas       Boolean             @default(false)
  /// Revision 4: the user's exam date (YOURS); a waypoint, never the aim's date, never sent to Gemini.
  examDay            DateTime?           @db.Date
  /// DRAFT | ACTIVE | PAUSED | DONE | ARCHIVED. DRAFT and ACTIVE hold a seat; PAUSED, DONE and ARCHIVED free it (decision 68).
  status             String              @default("DRAFT")
  /// Revision 5: the goal's seat, 1..3. Set on every DRAFT and ACTIVE row from lane 3 on; a PAUSED row keeps its last value outside the index (contracts §22.1 ruling 46); null on rows saved before lane 3.
  /// Not expressible in Prisma 6 (data-model.md): CHECK "Roadmap_slot_range" (slot null or 1..3); partial UNIQUE "Roadmap_userId_slot_open_key" (userId, slot) WHERE status IN ('DRAFT','ACTIVE').
  /// Migration B (lane 5): CHECK "Roadmap_slot_open_required" (status NOT IN ('DRAFT','ACTIVE') OR slot IS NOT NULL): an open row always has a seat.
  slot               Int?
  /// Revision 5: the user's own name for the goal (at most GOAL_LABEL_MAX, 16 characters); null = the Area name.
  label              String?
  pausedAt           DateTime?
  /// Revision 5: the user's reason for a pause (at most GOAL_PAUSE_REASON_MAX, 120 characters).
  pauseReason        String?
  /// Revision 5: the client nonce that created the row ([A-Za-z0-9_-]{8,64}), so a double tap returns the same id.
  /// Not expressible in Prisma 6: partial UNIQUE "Roadmap_userId_createKey_key" (userId, createKey) WHERE createKey IS NOT NULL.
  createKey          String?
  /// Revision 5 (migration B): LEVELS | TOPICS, the live version's kind; every existing row is LEVELS.
  planKind           String              @default("LEVELS")
  /// Revision 5: the RatingRecord (Gemini's difficulty estimate), the live version's; copied to the acceptance.
  rating             Json?
  /// Revision 5: SplitClause[]: the aim's clauses tracked in another goal.
  splitClauses       Json?
  /// Revision 5: DraftPlan (contracts §22.1 ruling 49): an open re-plan draft's {version, planKind, depth, rating} while they differ from the live version's,
  /// as a [Break into topics] draft of a LEVELS plan has them. planKind, depth and rating stay the live version's and change only inside acceptCore's
  /// transaction and undoAcceptCore's. Null on every existing row.
  draftPlan          Json?
  /// The accepted version; 0 before the first acceptance. A draft or re-plan writes its milestones at version + 1.
  version            Int                 @default(0)
  /// Set at the first acceptance (the end-state anchor); cleared only by that acceptance's Undo.
  firstAcceptedDay   DateTime?           @db.Date
  /// Set once, when the aim is reached on confirmed readings; never cleared.
  reachedDay         DateTime?           @db.Date
  doneAt             DateTime?
  /// The user's typed reason when marked done before the aim was reached.
  doneReason         String?
  archivedAt         DateTime?
  archiveReason      String?
  /// Skills (blueprint P5, migration 20261230000000_competencies): the Competency this roadmap's practices and steps
  /// count toward, unless a practice names its own (TaskTemplate.competencyId wins); null = none. A plain id, no FK.
  competencyId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  runs               RoadmapRun[]
  milestones         RoadmapMilestone[]
  acceptances        RoadmapAcceptance[]
  questWeeks         RoadmapQuestWeek[]
  topics             RoadmapTopic[]
  topicEdges         RoadmapTopicEdge[]

  @@index([userId, status])
  @@schema("public")
}

/// One drafting run: a Gemini call (claimed RUNNING, finished in after()),
/// a reuse, or the in-house starter or manual builder. GEMINI runs count
/// toward ROADMAP_DRAFTS_PER_DAY (any status but REUSED).
model RoadmapRun {
  id            String    @id @default(cuid())
  roadmapId     String
  roadmap       Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  userId        String
  /// The life day it was claimed (the cap's day).
  day           DateTime  @db.Date
  /// The version its milestones are written at.
  version       Int
  /// GEMINI | INHOUSE | MANUAL.
  kind          String
  /// RUNNING | OK | PARTIAL | FAILED | CAPPED | REUSED.
  status        String
  model         String?
  modelVersion  String?
  promptVersion Int?
  seedBase      Int?
  inputHash     String?
  /// The exact prompt lines sent, plus the server-only keymap and the sorted domain-id hash.
  pack          Json?
  /// The raw replies (at most 32 KB each), unedited.
  samples       Json?
  /// The ValidationReport: every drop, flag and note with its reason.
  report        Json?
  usage         Json?
  responseIds   String[]  @default([])
  finishReasons String[]  @default([])
  latencyMs     Int?
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// Revision 5: RATE | MAP | LINK | GROUND | DEEPER. Null is a run with no model phase (every LEVELS run, and a TOPICS draft built with no model).
  /// A GEMINI run with a null phase still counts toward ROADMAP_DRAFTS_PER_DAY, and so does phase RATE, the chain head (contracts §22.1 ruling 17).
  phase         String?
  /// Revision 5: GroundRunRecord (webSearchQueries, chunk titles and uris, the verdict per key, the title mode, toolUsePromptTokenCount). Server only, never in a view.
  grounding     Json?
  /// Revision 5: every model request the run made, against ROADMAP_REQUESTS_PER_DAY and GROUNDED_REQUESTS_PER_DAY; older rows read 0 (a LEVELS run writes it from lane 10, ruling 66).
  requests      Int       @default(0)

  @@index([userId, day])
  @@index([userId, inputHash])
  @@index([roadmapId, status])
  @@schema("public")
}

/// One milestone of one version. Rows of an accepted version that are
/// PLANNED, STARTING or STARTED change only through guarded transitions
/// (updateMany on the expected status). CLOSED, DROPPED and REACHED are
/// derived (the goal's closedScore and archivedAt, and reachedDay), never stored.
model RoadmapMilestone {
  id              String             @id @default(cuid())
  roadmapId       String
  roadmap         Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version         Int
  /// Stable across versions and "Start again": a re-plan keeps it for a carried position.
  lineageId       String
  ord             Int
  /// Never contains a target (the target lives in the measure line, rendered at read time).
  title           String
  /// GEMINI | CODE | USER | SYLLABUS.
  titleOrigin     String
  /// PENDING | KEPT | CHECKED | EDITED | REMOVED.
  titleDecision   String             @default("PENDING")
  /// Null on LATER rows.
  windowStart     DateTime?          @db.Date
  dueDay          DateTime?          @db.Date
  /// DRAFT | PLANNED | STARTING | STARTED | LATER | SUPERSEDED | DISCARDED.
  status          String             @default("DRAFT")
  /// The MID goal (a TaskTemplate id, krMetric 'ROADMAP') Start created; no foreign key.
  goalId          String?            @unique
  startedDay      DateTime?          @db.Date
  startingAt      DateTime?
  /// Set once on a confirmed reach; never cleared.
  reachedDay      DateTime?          @db.Date
  /// The day g first reached 1 on a milestone with a self-reported part, until confirmed or cleared.
  reachPendingDay DateTime?          @db.Date
  overAccepted    Boolean            @default(false)
  /// The acceptance's per-milestone snapshot; after Start, its StartSnapshot.
  feasibility     Json?
  /// 1 to 5 on scheduled rows (min(place, RANK_MILESTONE_MAX)); null on LATER rows. Written only by acceptCore on DRAFT rows.
  rankIndex       Int?
  /// Revision 4: FOUNDATION | FAMILIAR | RETAINED | FLUENT | MASTERED | BETWEEN | PART | STAGE_1..STAGE_5; null on rows made before revision 4.
  stage           String?
  /// Revision 5: 1..6 on a TOPICS layer milestone; null on every LEVELS row.
  layer           Int?
  /// Revision 5: LAYER | DEPTH on a TOPICS milestone; null on every LEVELS row.
  chainRole       String?
  createdAt       DateTime           @default(now())
  items           RoadmapItem[]
  measures        RoadmapMeasure[]
  questWeeks      RoadmapQuestWeek[]

  @@index([roadmapId, version, ord])
  @@index([lineageId])
  @@schema("public")
}

/// One Domain, Topic, Practice, Step or Checkpoint of a milestone, with its
/// provenance (origin and decision) and the checker's flags and notes.
model RoadmapItem {
  id              String           @id @default(cuid())
  milestoneId     String
  milestone       RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  lineageId       String
  /// DOMAIN | TOPIC | PRACTICE | STEP | CHECKPOINT.
  kind            String
  ord             Int
  label           String
  /// The text exactly as the model returned it (at most 200 characters).
  rawLabel        String?
  /// GEMINI | CODE | USER | SYLLABUS.
  origin          String
  /// PENDING | KEPT | CHECKED | EDITED | REMOVED.
  decision        String           @default("PENDING")
  decidedAt       DateTime?
  /// A resolved Domain (a DOMAIN item's; a TOPIC's Domain). No foreign key.
  domainId        String?
  /// A proposed new Domain's name, until the user creates or maps it.
  proposedName    String?
  /// The syllabus line index a topic covers.
  syllabusRef     Int?
  /// A practice's method (DELIBERATE_PRACTICE | READING | PROJECT_WORK | COACHED_SESSION | WORKOUT | WRITING).
  method          String?
  sessionsPerWeek Int?
  /// D15 | D20 | D30 | D45 | D60 | D90 | D120.
  durationBand    String?
  /// A recurrence.ts rule: 'DAILY' or 'TARGET:<n>/W', or fixed days the user picked.
  rule            String?
  /// WORKED_OUT | YOURS (sessions, band and rule).
  planSource      String?
  /// MOCK_TEST | PERFORMANCE_CHECK | SELF_TEST.
  checkpointKind  String?
  /// The user's own (YOURS) checkpoint scale and bar.
  outOf           Float?
  bar             Float?
  addToToday      Boolean          @default(true)
  /// The TaskTemplate Start created for a practice or step. No foreign key.
  templateId      String?
  /// Revision 4: the roadmap-catalog.ts key of a practice, step or checkpoint type (its label is re-rendered from it); null otherwise.
  catalogKey      String?
  flags           String[]         @default([])
  notes           String[]         @default([])
  createdAt       DateTime         @default(now())

  @@index([milestoneId])
  @@index([templateId])
  @@index([domainId])
  @@schema("public")
}

/// What a milestone's progress is judged by: CARDS_AT_LEVEL and
/// PRACTICE_KEPT pay (g is their minimum, with the steps' share);
/// CHECKPOINT is context only. measureKey carries no target.
model RoadmapMeasure {
  id             String           @id @default(cuid())
  milestoneId    String
  milestone      RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// CARDS_AT_LEVEL | PRACTICE_KEPT | CHECKPOINT.
  kind           String
  /// PAYS | CONTEXT.
  role           String
  /// {domainIds} | {itemLineageIds, templateIds} | {itemLineageIds} (a checkpoint's one lineage).
  scope          Json
  minLevel       Int?
  target         Float
  /// WORKED_OUT | YOURS.
  targetSource   String
  fittedTarget   Float?
  /// SCOPE | FIELD | YOURS | NONE.
  rateSource     String?
  /// The high-water baseline set at acceptance or Start.
  baseline       Float?
  baselineDay    DateTime?        @db.Date
  unit           String?
  itemLineageId  String?
  measureKey     String?
  /// Revision 5: the RoadmapTopic lineage it measures (display only); null on LEVELS.
  topicLineageId String?
  createdAt      DateTime         @default(now())

  @@index([milestoneId])
  @@index([measureKey])
  @@schema("public")
}

/// A forward-written reading: one row per measureKey per life day. COMPUTED
/// rows are upserted for today only, guarded on source and observedAt;
/// SELF rows (checkpoint logs) are append-only under their own key space.
/// PROFICIENCY|r:<roadmapId> rows hold each ACTIVE roadmap's Proficiency.
/// Raw INSERTs supply their own id (no database default).
model RoadmapReading {
  id         String   @id @default(cuid())
  userId     String
  measureKey String
  day        DateTime @db.Date
  value      Float
  detail     Json?
  /// COMPUTED | SELF.
  source     String   @default("COMPUTED")
  /// When the computation started: an older computation never overwrites a newer one.
  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, measureKey, day])
  @@index([userId, day])
  @@schema("public")
}

/// One acceptance of one version. Never updated, except to set undoneAt once.
model RoadmapAcceptance {
  id                 String    @id @default(cuid())
  roadmapId          String
  roadmap            Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version            Int
  day                DateTime  @db.Date
  acceptedAt         DateTime  @default(now())
  previousVersion    Int
  /// The plan's per-milestone snapshot, each with its per-week plan.
  feasibility        Json
  /// [{measureKey, target, baseline, baselineDay, label}] as accepted.
  endState           Json
  /// The review-spacing multiplier m at acceptance.
  intervalMultiplier Float
  overAccepted       Boolean   @default(false)
  undoneAt           DateTime?
  /// Revision 5: PreviousPlan (contracts ruling 49): the planKind, depth, rating and domainIds an accept of another kind replaced, which undoAcceptCore restores.
  /// Null on every existing row and on any accept that keeps the kind.
  previousPlan       Json?

  @@index([roadmapId, version])
  @@schema("public")
}

/// One life week's week quests for one started milestone, frozen once
/// ('rq:<milestoneId>:<weekStart>', ON CONFLICT DO NOTHING). quests, basis,
/// state, cappedBy, generator and source are never updated; results and
/// finalizedAt are set once, after the week has settled. Week quests pay
/// nothing. Raw INSERTs supply their own id (no database default).
model RoadmapQuestWeek {
  id          String           @id @default(cuid())
  userId      String
  roadmapId   String
  roadmap     Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// The life week's Monday.
  weekStart   DateTime         @db.Date
  dedupeKey   String
  /// CRON | START | RENDER.
  source      String
  /// OPEN | HELD | PAST_DUE.
  state       String           @default("OPEN")
  /// WEEK_QUEST_GENERATOR_VERSION.
  generator   Int
  /// WeekQuestSpec[] as issued; [] for an empty set.
  quests      Json
  /// string[]: what produced each count.
  basis       Json
  /// CATCHUP | CAPACITY | null.
  cappedBy    String?
  /// {closedDay, rows: [{ord, progress, done}], heldAfterFreeze}; null until final.
  results     Json?
  finalizedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([roadmapId, weekStart])
  @@index([milestoneId])
  @@schema("public")
}

// Revision 5 (migration B, lane 5; docs/life-plan/data-model.md, contracts §22).
// Neither topic table has a userId column: like RoadmapMilestone and RoadmapItem,
// ownership is the parent Roadmap's (FK, cascade), and every read goes through a
// roadmap the user owns.

/// One topic of one version's topic map (a TOPICS plan's layer rows).
model RoadmapTopic {
  id         String    @id @default(cuid())
  roadmapId  String
  roadmap    Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  /// The version its map belongs to (a draft or re-plan writes version + 1, as milestones do).
  version    Int
  /// Stable across versions; edges and RoadmapMeasure.topicLineageId point at it.
  lineageId  String
  /// S<n> (outline line n), U<n> (intake Domain n) or T<n> (every other topic); unique per version.
  key        String
  /// 1..6 (LAYERS_MAX).
  layer      Int
  /// What is shown: the exact sample form, the aim's own span, your words, or the Domain's name.
  name       String
  /// The text exactly as the model returned it (at most 200 characters). Server only, never in a view.
  rawName    String?
  /// GEMINI | SYLLABUS | USER | LIBRARY | AIM.
  nameOrigin String
  /// GENERAL | REGION_SPECIFIC; null when the name is not Gemini's.
  scope      String?
  /// GEMINI | YOU | CODE: who set its layer.
  placedBy   String
  /// LINKED | WEAK | NONE | NOT_RUN | OWN (OWN: a name that was never Gemini's).
  grounding  String
  /// At most 5 {title, uri}, from groundingChunks.web only.
  sources    Json      @default("[]")
  /// Samples holding the exact form (or the aim's span), 0..3; valid samples of the phase.
  formVotes  Int       @default(0)
  samples    Int       @default(0)
  /// Each voting sample's layer.
  layerVotes Json      @default("[]")
  /// PENDING | KEPT | EDITED | REMOVED | MERGED.
  decision   String    @default("PENDING")
  /// The lineage id it was merged into (MERGED).
  mergedInto String?
  chosen     Boolean   @default(false)
  /// BASE | DEEP (DEEP: chosen in the last layer, the specialisation).
  role       String    @default("BASE")
  /// Its Domain once bound or created at accept. No foreign key, like Roadmap.domainIds.
  domainId   String?
  /// You bound it ([Use my Domain…], or a seed or a pick you ticked).
  bound      Boolean   @default(false)
  /// "Held when you began" (measured at accept).
  heldDay    DateTime? @db.Date
  /// "I know this" (your skip).
  skippedDay DateTime? @db.Date
  flags      String[]  @default([])
  notes      String[]  @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([roadmapId, version, key])
  @@index([roadmapId, version])
  @@index([domainId])
  @@schema("public")
}

/// A "builds on" link; the whole-layer default ("after layer N") is no row at all.
model RoadmapTopicEdge {
  id              String   @id @default(cuid())
  roadmapId       String
  roadmap         Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version         Int
  /// For a cross-goal parent: "x:<parentDomainId>" (CROSS_GOAL_PARENT_PREFIX; the Domain is the parent), so one child's edges to two other goals' Domains keep distinct keys (contracts §22.1 ruling 48).
  parentLineageId String
  childLineageId  String
  /// Cross-goal only: the other goal's Domain and roadmap. Read-only: it can open a gate, and pays and counts nothing here.
  parentDomainId  String?
  parentRoadmapId String?
  /// GEMINI | USER | CODE | SYLLABUS | CROSS_GOAL (CODE and SYLLABUS are reserved; nothing writes them in this build).
  origin          String
  /// Valid LINK samples that chose it; valid LINK samples for that child.
  votes           Int      @default(0)
  samples         Int      @default(0)
  /// A GEMINI edge counts as a parent only when drawn (3 of 3 valid replies, previous layer of at least 4 kept topics).
  drawn           Boolean  @default(false)
  /// PENDING | KEPT | EDITED | REMOVED.
  decision        String   @default("PENDING")
  /// OUTLINE | LINE_DOMAIN | NONE (C8).
  match           String   @default("NONE")
  createdAt       DateTime @default(now())

  // Named explicitly: the default name is 69 characters, over Postgres's 63.
  @@unique([roadmapId, version, parentLineageId, childLineageId], map: "RoadmapTopicEdge_version_parent_child_key")
  @@schema("public")
}

/// A work tab beside the personal Board (2026-10-12): up to 3 open per user (slot 1..3), each with its own tasks, habits,
/// musts and call backs. Archived, never deleted: archiving frees the slot and keeps everything; Settings restores it.
/// Not expressible in Prisma 6: CHECK "WorkBoard_slot_range" (slot 1..3); partial UNIQUE "WorkBoard_userId_slot_open_key"
/// (userId, slot) WHERE archivedAt IS NULL (migration 20261217000000_work_boards).
/// crmOn (2026-10-12, migration 20261218000000_customers): this tab keeps a customer list (Customer); off by default.
/// followUpDays (2026-10-20, migration 20261228000000_crm; crm.ts followUpOf): a kept customer, not Inactive, quiet for
/// more than this many days with nothing scheduled ahead, or with an overdue task, shows under Follow up (the Agenda,
/// the Customers page); null is off. Not expressible in Prisma 6: CHECK "WorkBoard_followUpDays_check" (null, or 1..365).
model WorkBoard {
  id             String           @id @default(cuid())
  userId         String
  name           String
  slot           Int
  crmOn          Boolean          @default(false)
  /// The tab keeps an order list (WorkOrder; migration 20261224000000_work_orders); off by default.
  ordersOn       Boolean          @default(false)
  /// Follow-up alerts after this many quiet days (7 | 14 | 30 | 60 | 90 in the tab's menu); null: off.
  followUpDays   Int?             @default(30)
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          TaskTemplate[]
  callBacks      CallBack[]
  customers      Customer[]
  orders         WorkOrder[]
  /// The tab's scheduled tasks (ScheduledTask; migration 20261227000000_scheduled_tasks): its agenda.
  scheduledTasks ScheduledTask[]
  /// Its task collections and its deals pipeline (migration 20261228000000_crm).
  collections    TaskCollection[]
  deals          Deal[]

  @@index([userId, archivedAt])
  @@schema("public")
}

/// A call back on a work board: when it happened, how (PHONE | IN_PERSON), a brief as tags (per board), and an optional
/// call-back task with a reminder (remindAt + remindAction) that the push dispatcher sends once (remindSentAt).
/// LEGACY (2026-10-20, migration 20261227000000_scheduled_tasks): read once by the backfill into ScheduledTask (and a
/// CustomerInteraction for the call when it names a customer), then never written again. Kept, never dropped.
model CallBack {
  id           String        @id @default(cuid())
  userId       String
  boardId      String
  board        WorkBoard     @relation(fields: [boardId], references: [id], onDelete: Restrict)
  at           DateTime
  action       String
  tags         String[]      @default([])
  taskId       String?
  task         TaskTemplate? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Optional: the customer this call back was with (same board's CRM).
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  remindAt     DateTime?
  remindAction String?
  remindSentAt DateTime?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, boardId, at])
  @@index([remindAt])
  @@schema("public")
}

/// A customer in a work tab's CRM (2026-10-12, migration 20261218000000_customers). `number` is the customer's own ID
/// as the user types it (trimmed); search goes by it. Archived, never deleted.
/// Not expressible in Prisma 6: partial UNIQUE "Customer_boardId_number_open_key" (boardId, lower(number)) WHERE
/// archivedAt IS NULL, so an ID is unique per tab ignoring case, and archiving frees it.
/// status, tags, email, company, address (2026-10-20, migration 20261228000000_crm; crm.ts): where they stand (LEAD |
/// PROSPECT | CUSTOMER | INACTIVE; every customer before it reads CUSTOMER), the user's own tags (lowercase, ≤ 24
/// characters each, ≤ 8) and more details. Not expressible in Prisma 6: CHECK "Customer_status_check" (the four).
model Customer {
  id             String                @id @default(cuid())
  userId         String
  boardId        String
  board          WorkBoard             @relation(fields: [boardId], references: [id], onDelete: Restrict)
  number         String
  name           String
  nickname       String?
  phone          String?
  /// LEAD | PROSPECT | CUSTOMER | INACTIVE (crm.ts CUSTOMER_STATUSES).
  status         String                @default("CUSTOMER")
  tags           String[]              @default([])
  email          String?
  company        String?
  address        String?
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  interactions   CustomerInteraction[]
  tasks          CustomerTask[]
  callBacks      CallBack[]
  orders         WorkOrder[]
  infos          CustomerInfo[]
  /// Their scheduled tasks on the tab's agenda (ScheduledTask.customerId; migration 20261227000000_scheduled_tasks).
  scheduledTasks ScheduledTask[]
  /// Their Check log, task collections and deals (migration 20261228000000_crm).
  checks         CustomerCheck[]
  collections    TaskCollection[]
  deals          Deal[]

  @@index([userId, boardId])
  @@schema("public")
}

/// A customer's info (2026-10-14, migration 20261225000000_customer_info): a note (detail) and when it was recorded
/// (recordedAt, default now, editable). Newest first on the customer page; archivedAt hides one. Work, never pay.
model CustomerInfo {
  id         String    @id @default(cuid())
  userId     String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  detail     String
  recordedAt DateTime  @default(now())
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId, recordedAt])
  @@schema("public")
}

/// One line of a customer's interaction log: when, what (PURCHASE | INQUIRY | COMPLAINT | CREDIT_CHECK, and from
/// 2026-10-20 CALL | VISIT | EMAIL | MESSAGE; customers.ts CUSTOMER_ACTIONS), a brief. archivedAt hides a mistaken entry.
/// legacyCallBackId (migration 20261227000000_scheduled_tasks): the CallBack this entry was backfilled from (the call it
/// logged), so the backfill inserts each call once however often it runs; null on every entry made in the app.
model CustomerInteraction {
  id               String    @id @default(cuid())
  userId           String
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  at               DateTime
  action           String
  brief            String    @default("")
  tags             String[]  @default([])
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  legacyCallBackId String?   @unique

  @@index([customerId, at])
  @@schema("public")
}

/// A scheduled task for a customer (date, task, detail) and its reminder: the push dispatcher sends it once at dueAt
/// (remindSentAt). Moving dueAt clears remindSentAt. Work, never part of the game.
/// LEGACY (2026-10-20, migration 20261227000000_scheduled_tasks): read once by the backfill into ScheduledTask, then never
/// written again. Kept, never dropped.
model CustomerTask {
  id           String    @id @default(cuid())
  userId       String
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  dueAt        DateTime
  title        String
  detail       String?
  remind       Boolean   @default(true)
  doneAt       DateTime?
  remindSentAt DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId, dueAt])
  @@index([dueAt])
  @@schema("public")
}

/// A scheduled task on a work tab (2026-10-20, migration 20261227000000_scheduled_tasks): the one list that replaced call
/// backs (CallBack) and customer tasks (CustomerTask). When (dueAt; allDay: the day only, its reminder at 09:00 that day
/// in LIFE_TZ), what (title, detail), how (channel: CALL | VISIT | EMAIL | MESSAGE | OTHER), optionally for a customer of
/// the same tab, and one reminder (remind) that the push dispatcher sends once (remindSentAt; src/lib/reminders-server.ts)
/// and the app shows in place (the bell, the in-app banner). Moving dueAt ALWAYS clears remindSentAt
/// (src/lib/scheduled-tasks.ts). Done (doneAt) and archived (archivedAt), never deleted. Work, never part of the game.
/// legacyCallBackId / legacyCustomerTaskId: the row it was backfilled from (prisma/backfill/scheduled_tasks.sql), unique,
/// so the backfill can run again after a deploy and insert only what it has not; ?callback=<id> deep links resolve by it.
/// Every timestamp is timestamptz (the rest of the schema is timestamp(3) holding UTC; the backfill converts with
/// AT TIME ZONE 'UTC').
/// Not expressible in Prisma 6: CHECK "ScheduledTask_channel_check" (channel IN the five); partial INDEX
/// "ScheduledTask_remind_due_idx" ("dueAt") WHERE "remind" AND "remindSentAt" IS NULL AND "doneAt" IS NULL AND
/// "archivedAt" IS NULL (the dispatcher's claim). A future `migrate diff` proposal to drop either must be deleted.
/// collectionId (2026-10-20, migration 20261228000000_crm): the task collection it belongs to (one of its customer's;
/// scheduled-tasks-server checks the customer and the tab), SET NULL.
model ScheduledTask {
  id                   String          @id @default(cuid())
  userId               String
  boardId              String
  board                WorkBoard       @relation(fields: [boardId], references: [id], onDelete: Restrict)
  /// Optional: a customer of the same tab (customers are archived, never deleted; SetNull is only a backstop).
  customerId           String?
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dueAt                DateTime        @db.Timestamptz(3)
  allDay               Boolean         @default(false)
  title                String
  detail               String?
  /// CALL | VISIT | EMAIL | MESSAGE | OTHER.
  channel              String          @default("OTHER")
  remind               Boolean         @default(true)
  remindSentAt         DateTime?       @db.Timestamptz(3)
  doneAt               DateTime?       @db.Timestamptz(3)
  archivedAt           DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  legacyCallBackId     String?         @unique
  legacyCustomerTaskId String?         @unique
  /// Optional: one of its customer's task collections (TaskCollection; migration 20261228000000_crm).
  collectionId         String?
  collection           TaskCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  /// The agenda: a tab's open tasks by time, and its done ones.
  @@index([boardId, doneAt, dueAt])
  /// The bell and the in-app reminders: a user's open tasks by time.
  @@index([userId, doneAt, dueAt])
  /// A customer's page.
  @@index([customerId, dueAt])
  /// A collection's tasks (its progress).
  @@index([collectionId])
  @@schema("public")
}

/// A task's defer or abort and its reason (2026-10-13, migration 20261222000000_task_defer_abort). kind DEFER | ABORT;
/// scope ONCE (this occurrence) | SERIES (the whole task) for an abort, null for a defer; reasonTag a quick pick
/// (BLOCKED | NO_TIME | LOW_ENERGY | NOT_NEEDED | PLAN_CHANGED | WAITING) or null; day the life day it was decided;
/// untilAt the defer's target; compulsory whether the task was a Must then (a Must's defer or abort still counts as
/// not kept). undoneAt set by Undo. Append-only otherwise; work, never pay.
model TaskDecision {
  id         String       @id @default(cuid())
  userId     String
  templateId String
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind       String
  scope      String?
  reason     String
  reasonTag  String?
  day        DateTime     @db.Date
  untilAt    DateTime?
  compulsory Boolean      @default(false)
  undoneAt   DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, day])
  @@index([templateId])
  @@schema("public")
}

/// Word completion's memory of the user's choices (2026-10-13, migration 20261221000000_word_choices): per word
/// (lower case) and the word before it (lower case, "" for none), how often the user picked it from the suggestions
/// and how often they typed past it when it was the first suggestion. word-model.ts reads it with the corpus.
model WordChoice {
  id         String    @id @default(cuid())
  userId     String
  word       String
  context    String    @default("")
  picks      Int       @default(0)
  passes     Int       @default(0)
  lastPickAt DateTime?
  lastPassAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, word, context])
  @@index([userId])
  @@schema("public")
}

/// One line of a work tab's order list (2026-10-14, migration 20261224000000_work_orders): who (name, contact), what
/// (item), whether it has been ordered (orderedAt when ticked) and its date. customerId links a CRM customer of the
/// same tab when there is one. Archived, never deleted. Work, never part of the game.
model WorkOrder {
  id          String           @id @default(cuid())
  userId      String
  boardId     String
  board       WorkBoard        @relation(fields: [boardId], references: [id], onDelete: Restrict)
  name        String
  contact     String?
  item        String
  ordered     Boolean          @default(false)
  orderedAt   DateTime?
  date        DateTime?        @db.Date
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// The task collections for this order, and the deal it was created from (migration 20261228000000_crm).
  collections TaskCollection[]
  deals       Deal[]

  @@index([userId, boardId])
  @@schema("public")
}

/// A customer's check (2026-10-20, migration 20261228000000_crm; crm.ts cleanCheckInput): three short texts, Rate, Home
/// and Work (each optional, at least one; ≤ 200 characters each), and the day it was recorded (Record at: a calendar
/// day, today's life day in LIFE_TZ unless one is picked, never after today; the cores fill it). Newest first on the
/// customer's Check tab; archivedAt hides one (with Undo). Every timestamp is timestamptz. Work, never part of the game.
/// Not expressible in Prisma 6: CHECK "CustomerCheck_some_check" (rate, home or work is not null).
model CustomerCheck {
  id         String    @id @default(cuid())
  userId     String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rate       String?
  home       String?
  work       String?
  recordedAt DateTime  @db.Date
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  /// A customer's Check tab, newest first.
  @@index([customerId, recordedAt])
  @@schema("public")
}

/// A collection of one customer's scheduled tasks (2026-10-20, migration 20261228000000_crm; crm.ts): a name ("New NBN
/// service", an order's item), optionally the order it is for (a WorkOrder of the same tab and customer; SET NULL), a
/// note. Closed (closedAt) when its work is done, archived (archivedAt), never deleted; its tasks keep their own rows
/// (ScheduledTask.collectionId, SET NULL). Every timestamp is timestamptz. Work, never part of the game.
model TaskCollection {
  id         String          @id @default(cuid())
  userId     String
  boardId    String
  board      WorkBoard       @relation(fields: [boardId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name       String
  orderId    String?
  order      WorkOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note       String?
  closedAt   DateTime?       @db.Timestamptz(3)
  archivedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  tasks      ScheduledTask[]

  /// A customer's collections, the open ones first.
  @@index([customerId, closedAt])
  /// The workspace's index (a tab's open collections).
  @@index([boardId, closedAt])
  @@index([orderId])
  @@schema("public")
}

/// A deal on a work tab's pipeline (2026-10-20, migration 20261228000000_crm; deals.ts): a title, its value in AUD cents
/// (valueCents ≥ 0), its stage (NEW | QUOTED | WON | LOST), the day it is expected to close, a note, and optionally a
/// customer of the same tab (SET NULL). closedAt is stamped when it moves to Won or Lost and cleared when it moves back;
/// orderId is the order a Won deal became (Create order; SET NULL); sortOrder keeps a column's order. Archived, never
/// deleted. Every timestamp is timestamptz. Work, never part of the game.
/// Not expressible in Prisma 6: CHECK "Deal_stage_check" (the four) and CHECK "Deal_valueCents_check" (≥ 0).
model Deal {
  id               String     @id @default(cuid())
  userId           String
  boardId          String
  board            WorkBoard  @relation(fields: [boardId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title            String
  /// AUD cents, ≥ 0.
  valueCents       Int        @default(0)
  /// NEW | QUOTED | WON | LOST (deals.ts DEAL_STAGES).
  stage            String     @default("NEW")
  expectedCloseDay DateTime?  @db.Date
  note             String?
  closedAt         DateTime?  @db.Timestamptz(3)
  orderId          String?
  order            WorkOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sortOrder        Int        @default(0)
  archivedAt       DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  /// The pipeline: a tab's columns in order.
  @@index([boardId, stage, sortOrder])
  /// A customer's Deals tab.
  @@index([customerId])
  @@index([orderId])
  @@schema("public")
}

/// A browser's web-push subscription (2026-10-12; call back reminders). One row per endpoint.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  failedAt   DateTime?

  @@index([userId])
  @@schema("public")
}

// ── Avatar targets (migration 20261229000000_avatar_targets; blueprint P4, decisions D3 and D4) ──
// The desired self in numbers: a record, never a reward. Nothing in the economy reads this table, and no target pays
// XP, MP or a level. src/lib/avatar.ts holds the rules (the metric catalog, the share of the way, the pace, the words);
// src/lib/avatar-server.ts is its only reader and writer (scripts/status-check.ts pins that it writes no ledger).

/// One target for one attribute (VITALITY | INTELLECT | CRAFT | DUTY | CARE, or CAPITAL, a reading only), read by one
/// metric (avatar.ts AVATAR_METRICS: EFFORT_MINUTES | FIELD_LEVEL | TRACK_HOURS | REVENUE_MONTH | MANUAL). The weight
/// target is WeightGoal's own (no second copy), so no row has the metric WEIGHT. Rows are never edited in place: an
/// edit archives the row (archivedAt) and adds a new one with the same lineageId, so the history stays; an archive
/// alone retires the target. Readings live in RoadmapReading under 'AVATAR|a:<lineageId>' (COMPUTED from the degrade
/// cron, SELF for a MANUAL target's own logs), so they carry across edits. Every timestamp is timestamptz.
/// Not expressible in Prisma 6: CHECK "AvatarTarget_attribute_check" (the six), CHECK "AvatarTarget_metric_check" (the
/// five stored metrics), CHECK "AvatarTarget_direction_check" (UP | DOWN), CHECK "AvatarTarget_label_check" (1..40
/// characters), CHECK "AvatarTarget_baseline_check" (baselineValue and baselineDay both set or both null), and partial
/// UNIQUE "AvatarTarget_lineageId_live_key" (lineageId) WHERE archivedAt IS NULL.
model AvatarTarget {
  id            String    @id @default(cuid())
  userId        String
  /// The first version's id; every edit keeps it (the readings' key).
  lineageId     String
  /// VITALITY | INTELLECT | CRAFT | DUTY | CARE | CAPITAL (avatar.ts AVATAR_ATTRIBUTES).
  attribute     String
  label         String
  /// EFFORT_MINUTES | FIELD_LEVEL | TRACK_HOURS | REVENUE_MONTH | MANUAL (avatar.ts STORED_METRICS).
  metric        String
  /// What the metric reads: {fieldId} for FIELD_LEVEL, {} otherwise.
  scope         Json      @default("{}")
  /// min | h | level | AUD, or the user's own word for MANUAL (may be empty). Fixed for the lineage.
  unit          String
  /// UP (higher is closer) | DOWN (lower is closer).
  direction     String
  /// Where the bar measures from, in the unit, and the life day it was taken; both null until the user gives one.
  baselineValue Float?
  baselineDay   DateTime? @db.Date
  targetValue   Float
  /// An optional life day to reach it by (the pace reads it).
  targetDay     DateTime? @db.Date
  sortOrder     Int       @default(0)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  /// The Status card's read: a user's live targets.
  @@index([userId, archivedAt])
  /// A lineage's history.
  @@index([lineageId])
  @@schema("public")
}

// ── Skills: named competencies (migration 20261230000000_competencies; blueprint P5, decisions D7, D8 and D9) ──
// A record, never a reward: nothing in the economy reads this table, and no hour or tier pays XP, MP or a level (a
// tier-up is a Seal only, D9). src/lib/competency.ts holds the rules (the tiers, the hours from the ticks' minutes,
// the suggestions, the words); src/lib/competency-server.ts is its only reader and writer, and of the two link columns
// (TaskTemplate.competencyId, Roadmap.competencyId); scripts/status-check.ts pins that it writes no ledger.

/// One skill (D7: a named Competency that tasks, roadmaps and walks link to) of one attribute (VITALITY | INTELLECT |
/// CRAFT | DUTY | CARE). kind PRACTICE: its hours are the linked templates' tick minutes; EXERCISE (Vitality only, at most
/// one live): every logged walk too. Hours are derived on read, never stored, and a tier (0-100, 100-500, 500-2,000,
/// 2,000-10,000 h; D8) is read from them. Archived, never deleted; a link to an archived skill counts toward nothing.
/// Every timestamp is timestamptz.
/// Not expressible in Prisma 6: CHECK "Competency_attribute_check" (the five), CHECK "Competency_kind_check" (PRACTICE |
/// EXERCISE), CHECK "Competency_name_check" (1..40 characters), CHECK "Competency_exercise_check" (an EXERCISE skill is
/// VITALITY's), CHECK "Competency_field_check" (a fieldId only on an INTELLECT skill), partial UNIQUE
/// "Competency_userId_name_live_key" (userId, lower(name)) WHERE archivedAt IS NULL, and partial UNIQUE
/// "Competency_userId_exercise_live_key" (userId) WHERE kind = 'EXERCISE' AND archivedAt IS NULL.
model Competency {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// VITALITY | INTELLECT | CRAFT | DUTY | CARE (competency.ts SKILL_ATTRIBUTES; Capital has no skills).
  attribute  String
  /// PRACTICE | EXERCISE (competency.ts SKILL_KINDS).
  kind       String    @default("PRACTICE")
  /// An Intellect skill's Field (a plain id, no foreign key); null otherwise.
  fieldId    String?
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  /// The Skills page's read: a user's live skills.
  @@index([userId, archivedAt])
  @@schema("public")
}

// ── The Mall's catalog (migration 20261231000000_mall; blueprint P18, decision D30) ──
// A reward the user lists, with a price in credits: a record of what the user will pay, never a payment. Nothing in
// the economy reads this table: no row pays or costs XP, MP, a Domain point, capital or a credit (credits are derived,
// credits.ts; the buy, P19, records its own sink-NONE row and receipt). Only what the user lists is priced: there are
// no starter rewards, and #play, rest days and sleep are never priced (mall.ts cleanRewardInput refuses them).
// src/lib/mall.ts holds the rules (the categories, validatePrice, priceHint, the words); src/lib/mall-server.ts is its
// only reader and writer (scripts/credits-check.ts pins that it writes nothing else and no ledger).

/// One reward (D30: only rewards the user lists are priced) in one category (TREAT | SCREEN | OUTING | PURCHASE |
/// OTHER), at a whole-credit price (1..100,000), with an optional note and an optional cooldown (at most once every n
/// days, 1..365; P19's buy reads it). Archived, never deleted: an archive sets archivedAt and keeps the row. Every
/// timestamp is timestamptz.
/// Not expressible in Prisma 6: CHECK "MallReward_title_check" (1..60 characters), CHECK "MallReward_category_check"
/// (the five), CHECK "MallReward_price_check" (1..100000), CHECK "MallReward_note_check" (null or 1..200 characters),
/// CHECK "MallReward_cooldown_check" (null or 1..365), and partial UNIQUE "MallReward_userId_title_live_key" (userId,
/// lower(title)) WHERE archivedAt IS NULL.
model MallReward {
  id           String    @id @default(cuid())
  userId       String
  title        String
  /// TREAT | SCREEN | OUTING | PURCHASE | OTHER (mall.ts MALL_CATEGORIES).
  category     String
  /// Whole credits, 1..100,000 (mall.ts validatePrice).
  price        Int
  note         String?
  /// At most once every n days (1..365); null: no cooldown.
  cooldownDays Int?
  sortOrder    Int       @default(0)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  /// The Mall page's read: a user's live rewards, then the archived ones.
  @@index([userId, archivedAt])
  @@schema("public")
}

// ── Proof of work: a task's timer (migration 20270101000000_task_proof; blueprint P23, decision D20) ──
// A record of time, never a payment: nothing in the economy reads this table to pay. Only a tick pays (tasks.ts, its
// 'life-3' receipt), and a timer only supplies and bounds the minutes that tick reports. src/lib/proof.ts holds the
// rules (one running timer a user, a timer counted once, the wall-clock bound); src/lib/task-sessions-server.ts is its
// only reader and writer, apart from the one column a tick sets when it counts a timer (minutes, and endedAt when it
// still ran), inside the tick's own transaction. Every write waits for PROOF_LAUNCH_DAY (null in code).

/// One timer of one task: started (startedAt, on life day `day`), stopped (endedAt; null while it runs; a start stops
/// any other), and counted once by the tick that counts it (minutes; null until then). A plain templateId with no
/// foreign key. `clientId` is the start's key (a resend answers the session it started). Every timestamp is timestamptz.
/// Not expressible in Prisma 6: CHECK "TaskSession_minutes_check" (null or 0..480), CHECK "TaskSession_source_check" (web
/// | phone), CHECK "TaskSession_ended_check" (endedAt null or at/after startedAt), CHECK "TaskSession_clientId_check"
/// (1..64 characters), and partial UNIQUE "TaskSession_userId_running_key" (userId) WHERE endedAt IS NULL.
model TaskSession {
  id         String    @id @default(cuid())
  userId     String
  templateId String
  /// The life day it started on (src/lib/life-day.ts dateColumn).
  day        DateTime  @db.Date
  startedAt  DateTime  @db.Timestamptz(3)
  /// Stopped; null while it runs.
  endedAt    DateTime? @db.Timestamptz(3)
  /// What the tick that counted it counted (0..480); null until a tick counts it.
  minutes    Int?
  /// web | phone (proof.ts SESSION_SOURCES).
  source     String    @default("web")
  clientId   String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, clientId])
  /// The running timers' read (endedAt null).
  @@index([userId, endedAt])
  /// A tick's read: one task's timers not yet counted.
  @@index([userId, templateId])
  @@schema("public")
}
