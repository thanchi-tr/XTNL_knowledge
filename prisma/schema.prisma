// Gamified Spaced Repetition System — core data architecture.
// pgvector's `vector` column type is not a first-class Prisma type: it is declared
// via `Unsupported("vector(1536)")`, which means Prisma Migrate cannot create or
// alter it. The extension, the column, and its ANN index are created by the raw
// SQL migration in prisma/migrations/0_init/migration.sql instead — see that file
// and README.md "Database setup" for the full sequence.

generator client {
  provider = "prisma-client-js"

  // `relationJoins` lets a query opt into `relationLoadStrategy: "join"`,
  // which fetches a nested relation with a LATERAL JOIN instead of issuing a
  // second query and stitching the rows together in the client.
  //
  // That default cost a round trip per relation, which is invisible on a
  // local database and ruinous on a remote one: profiling showed every page
  // paying separate SELECTs for Field *and* FieldAttribute, Domain *and*
  // DomainAttribute, purely because they were expressed as nested selects.
  // At ~160ms per hop to Seoul, each of those was a sixth of the entire
  // performance budget for the page.
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
  // Single-schema mode. If you ever point this at a Supabase project whose
  // `public` schema has its own FK into `auth` (e.g. a custom `entities`
  // table), `prisma migrate`/`db pull` will fail with P4002 asking for
  // `schemas = ["public", "auth"]`. Don't add that pre-emptively — declaring
  // `auth` here makes Prisma's drift detection treat that whole schema as
  // something it should match against migration history, and since we never
  // define any auth.* models, every future `migrate dev` interprets
  // Supabase's own auth tables as un-reconcilable drift and offers to reset
  // both schemas. Add it back only if P4002 actually reappears, and expect
  // that warning again if you do.
  schemas    = ["public"]
}

enum CollectionLabel {
  BOOK
  ACTIONABLE
  PROPOSAL

  @@schema("public")
}

/**
 * How an Idea is drilled, and therefore how its answer is graded.
 * Each value has a verifier in `verification.ts`, an encoder in
 * `idea-payload.ts`, and a base XP in `xp.ts` — the switches over this enum
 * are deliberately exhaustive so adding a member fails to compile until
 * every one of them has been taught about it.
 */
enum QuestionType {
  /**
   * Free recall, graded on Dice-coefficient similarity.
   */
  SHORT
  /**
   * One correct option out of several.
   */
  MULTI
  /**
   * Labelled hotspots over an image.
   */
  DIAGRAM
  /**
   * Symbolic expression, graded by algebraic equivalence.
   */
  FORMULA
  /**
   * Fill-in-the-blank. One prompt yields as many blanks as it marks.
   */
  CLOZE
  /**
   * Enumerate a set of items; order irrelevant, completeness required.
   */
  LIST
  /**
   * Arrange items into the correct sequence.
   */
  ORDER
  /**
   * A number, graded within a tolerance, optionally carrying a unit.
   */
  NUMERIC

  @@schema("public")
}

/**
 * The thirteen base attributes every Field is composed from.
 * These are the substrate of the whole progression system: a Field declares
 * what mix of them it trains, Field levels flow into attribute scores
 * weighted by that mix, and skills gate on attribute scores. Nothing here
 * is per-Field hardcoded — the previous skill system keyed off literal
 * seeded Domain names like "Memory & Cognition", which meant renaming a
 * Domain silently disabled a skill and no user-created Field could ever
 * unlock anything.
 */
enum Attribute {
  MIND
  PHYSICAL
  CRITICAL_THINKING
  COMPASSION
  ABSTRACT
  LOGIC
  REASON
  REBUTTAL
  SELF_RESPECT
  FAITH
  CREATIVITY
  STUBBORNNESS
  STATISTIC

  @@schema("public")
}

model Field {
  id          String             @id @default(cuid())
  name        String             @unique
  level       Float              @default(1.0)
  domains     Domain[]
  snapshots   FieldSnapshot[]
  attributes  FieldAttribute[]
  streaks     FieldStreak[]
  bosses      BossEncounter[]
  maintenance FieldMaintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Domain {
  id                    String            @id @default(cuid())
  name                  String
  fieldId               String
  field                 Field             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  totalPoints           Float             @default(0)
  level                 Int               @default(1)
  ideas                 Idea[]
  attributes            DomainAttribute[]
  /**
   * How many Ideas have been folded into `attributes` so far.
   * Not the same as `ideas.length`: it is the observation count the running
   * blend in `attribute-inference.ts` divides by, so a Domain's identity
   * stabilises as it fills. Kept as its own counter because deletions
   * should not make the next submission swing the Domain harder.
   */
  attributeObservations Int               @default(0)
  /// Revision 5 (roadmap migration B, decision 63): 'GEMINI' when accept created it from a kept Gemini name; null = the user's (every row before revision 5).
  nameOrigin            String?
  /// Revision 5: the name as Gemini gave it. The Gemini mark shows while name = originName, so a rename removes it (roadmap-types geminiNamedOf).
  originName            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@schema("public")
}

/**
 * A Domain's inferred attribute split (attribute-inference.ts).
 * Mirrors `FieldAttribute` deliberately. A Field's name is a label someone
 * chose once; its Domains are where the subject is actually described, and
 * its Ideas are where it is described in detail. Storing the split here is
 * what lets `effectiveFieldComposition` weight a Field by what its Domains
 * turned out to be about rather than by whatever it was named.
 */
model DomainAttribute {
  id        String    @id @default(cuid())
  domainId  String
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  attribute Attribute
  /**
   * 0-100, summing to 100 across the thirteen.
   */
  weight    Int       @default(0)

  @@unique([domainId, attribute])
  @@index([domainId])
  @@schema("public")
}

model Idea {
  id                  String          @id @default(cuid())
  domainId            String
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  collectionLabel     CollectionLabel
  level               Int             @default(1) // Max 12
  basePoints          Float           @default(0)
  yieldPoints         Float           @default(0)
  fragments           Int             @default(1)
  question            String // JSON stringified for complex types (MULTI options, DIAGRAM hotspots)
  questionType        QuestionType
  answer              String // JSON stringified for complex types
  /// Capitals must match when grading (SHORT answers, cloze blanks, LIST items). Chosen when the idea is written; off by default.
  answerCaseSensitive Boolean         @default(false)
  dueDate             DateTime
  graceEndsAt         DateTime?
  failedAttempts      Int             @default(0)
  endorsements        Int             @default(0)
  isArchived          Boolean         @default(false)
  linkedIdeaIds       String[]        @default([])

  /**
   * 0–100, decided automatically from what the card asks (src/lib/difficulty.ts).
   * A property of the question, not of your history with it: format,
   * how much must be produced, vocabulary density and required precision.
   * Review performance deliberately does not feed it — level, interval and
   * degradation already track that, and letting difficulty move with
   * performance would count the same signal twice and pay you more for the
   * cards you keep failing.
   * The band (Intro/Standard/Demanding/Severe) is derived on read rather
   * than stored, so recalibrating the thresholds does not require rewriting
   * every row.
   */
  difficulty Int @default(0)

  /**
   * Memory-engineering node data (src/lib/dedup.ts). Distinct from
   * `question`/`answer`, which are the *drill* — what the review session
   * shows you. These are the *node*: what this Idea asserts, used for
   * deduplication and library browsing.
   * Nullable, and left that way: every Idea predating the dedup pipeline
   * has none, and populating them retroactively would mean one Gemini call
   * per existing row. Readers must tolerate the absence — `enrichNode`
   * falls back to `question` when `corePremise` is null, and the dedup
   * reasoning strings fall back to the Idea id when `title` is null.
   */
  title        String?
  corePremise  String?
  atomicPrompt String?
  tags         String[] @default([])

  /**
   * The single attribute this Idea most exercises, inferred from its own
   * wording and question type (attribute-inference.ts).
   * A label, not a weight vector: the full composition an Idea produces is
   * folded into its Domain at creation and does not need storing per row.
   * Nullable because everything created before inference existed has none,
   * and because a submission can be too generic to call.
   */
  attribute Attribute?

  enrichments IdeaEnrichment[]

  // pgvector column — managed by raw SQL migration, not Prisma Migrate.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domainId])
  @@index([dueDate])
  @@schema("public")
}

/**
 * Append-only log of ENRICH_EXISTING merges (src/lib/dedup.ts).
 * When a candidate lands in the enrichment band it adds nuance to an Idea
 * that already exists rather than deserving its own node. The obvious
 * implementation — rewriting `Idea.corePremise` in place — silently
 * destroys the prior wording on every merge, and since the merge decision
 * is automatic there'd be no way to audit what a node used to say or undo
 * a bad call. So enrichments accumulate here instead: `Idea` keeps its
 * original premise, and the full picture is the premise plus its
 * enrichments in `createdAt` order.
 * `similarity` records the cosine score that triggered the merge, which is
 * what you need to tune thresholds against real data later.
 */
model IdeaEnrichment {
  id         String @id @default(cuid())
  ideaId     String
  idea       Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  payload    String // the new nuance, as written by the synthesis call
  sourceText String // the raw candidate text that produced it, kept for auditability
  similarity Float

  createdAt DateTime @default(now())

  @@index([ideaId])
  @@schema("public")
}

/**
 * One row per (Field, calendar day) — powers the Dashboard's "ghost" radar
 * comparison (current stats vs. 7 days ago). There's no other activity-log
 * table in this schema; rather than reconstruct history after the fact,
 * this is written forward from today via an upsert every time the
 * Dashboard is viewed (src/lib/snapshot.ts). It starts empty — a 7-day-old
 * snapshot only exists once the app has actually been open on that day.
 */
model FieldSnapshot {
  id          String   @id @default(cuid())
  fieldId     String
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  day         DateTime // truncated to UTC midnight — the calendar day this snapshot represents
  level       Float
  totalPoints Float // sum of this Field's Domains' totalPoints at snapshot time

  createdAt DateTime @default(now())

  @@unique([fieldId, day])
  @@schema("public")
}

/**
 * One Field's weighting across the thirteen attributes.
 * Weights are integers summing to 100 per Field — a percentage split of
 * what that Field trains. Modelled as rows rather than a JSON blob on
 * Field so a weight is queryable and constrained, matching how the rest of
 * this schema represents structure.
 */
model FieldAttribute {
  id        String    @id @default(cuid())
  fieldId   String
  field     Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  attribute Attribute
  weight    Int       @default(0) // 0..100; per-Field sum == 100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, attribute])
  @@index([fieldId])
  @@schema("public")
}

/**
 * Append-only mastery-point ledger.
 * Mastery points are the scarce currency skills are bought with, so the
 * balance is the sum of deltas rather than a mutable counter: spends are
 * negative rows, and every grant records what earned it. A single mutable
 * `balance` column would make an incorrect award impossible to trace or
 * reverse, and grading (see `reason`) can involve a model call whose
 * output should stay auditable.
 */
/**
 * Machine-readable `reason` values, for reference (no DB enum — this stays
 * a free string so a new income/expense source never needs a migration):
 * IDEA_MASTERED | REVIEW_FRACTION | ATTESTATION | SKILL_UNLOCK |
 * BOSS_VICTORY | DECAY.
 */
model MasteryLedgerEntry {
  id     String  @id @default(cuid())
  userId String
  /**
   * Positive to grant, negative to spend/decay. Float, not Int: every
   * successful review now mints a small fraction of a point
   * (`reviewMasteryFraction` in mastery.ts) rather than only whole points
   * on rare events, and decay debits are fractional too. The balance
   * (`sum(delta)`) is still rounded for display and truncated toward zero
   * wherever it gates a whole-number `Skill.masteryCost`.
   */
  delta  Float
  reason String
  /**
   * Free-text detail — the graded rationale, or the skill code purchased.
   */
  detail String?
  ideaId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * Per-(user, Field) Boss state — the chance-and-stakes layer over a Field's
 * hardest due material. A Boss unlocks once its Field clears
 * `BOSS_UNLOCK_LEVEL` (bosses.ts); challenging it runs a capped, themed
 * review batch through the normal SRS engine (real grading, no separate
 * game state), and only the aggregate accuracy is judged here.
 * `tier` climbs on every victory — the Boss "respawns stronger," which is
 * what makes it replayable rather than a one-time unlock. `cooldownUntil`
 * paces re-attempts (shorter after a loss, longer after a win) so this
 * reads as a periodic event to look forward to, not a grindable loop.
 */
model BossEncounter {
  id            String    @id @default(cuid())
  userId        String
  fieldId       String
  field         Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  tier          Int       @default(1)
  victories     Int       @default(0)
  lastVictoryAt DateTime?
  lastAttemptAt DateTime?
  cooldownUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

/**
 * A temporary *positive* modifier — the spoils of a Boss victory
 * (boons.ts). Mirrors `ActiveDebuff` deliberately rather than sharing a
 * table with it: the two are folded into `ActiveModifiers` by different
 * code with opposite sign conventions, and one table holding both would
 * make every read site check which kind it was looking at.
 * Boons come from a Spoils Cache. Which boon you draw is random; that a
 * victory yields one, and the mastery it pays alongside, are not — see
 * `boons.ts` for why that distinction is the whole design.
 */
model ActiveBoon {
  id        String   @id @default(cuid())
  userId    String
  /**
   * BoonKind from boons.ts, e.g. "INSIGHT" | "MOMENTUM" | "FOCUS".
   */
  kind      String
  magnitude Float
  /**
   * Machine-readable source: BOSS_SPOILS.
   */
  reason    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * A temporary negative modifier (debuffs.ts) — the inverse of an unlocked
 * skill's permanent buff. Sourced from real setbacks (losing a Boss fight,
 * a long Field streak breaking) rather than randomly, and always bounded
 * and self-expiring: nothing here ever touches `Idea`/`Domain` state, only
 * `ActiveModifiers`, so a debuff can sting without damaging the underlying
 * knowledge base.
 */
model ActiveDebuff {
  id        String   @id @default(cuid())
  userId    String
  /**
   * DebuffKind from debuffs.ts, e.g. "SHAKEN" | "FATIGUED" | "DOUBT".
   */
  kind      String
  magnitude Float
  /**
   * Machine-readable source: BOSS_DEFEAT | STREAK_BROKEN.
   */
  reason    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

/**
 * Per-Field daily activity streak.
 * Distinct from the global streak derived in src/lib/streak.ts: that one
 * answers "did you show up at all", this one answers "did you keep faith
 * with *this* subject", which is what field-streak skill effects key off.
 * Stored rather than derived because it needs a per-Field last-active day
 * and `Idea.updatedAt` alone can't distinguish a review from an edit.
 */
/**
 * A Field the user has put into maintenance mode.
 * Stored as the *exception* rather than as the interest, which is what makes
 * this safe to add to a live database with no backfill: no rows means every
 * Field is of interest, exactly the behaviour that existed before this table.
 * Marking a Field inserts a row; unmarking deletes it. There is no state in
 * which the set is ambiguous or in which an empty table silently disables
 * every challenge and quota at once.
 * A maintained Field keeps reviewing normally — its Ideas come due, degrade
 * and pay out exactly as before. It is only excused the weekly new-Idea quota
 * and excluded from Boss encounters.
 */
model FieldMaintenance {
  id      String @id @default(cuid())
  userId  String
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

/**
 * Append-only capital ledger — the passive currency.
 * Deliberately a third currency with a job the other two do not do. Domain
 * points measure what a subject is worth; mastery is *earned by answering*
 * and buys new emblems. Capital accrues from what you already hold, whether
 * or not you show up, and is only ever spent deepening emblems you own. So
 * the three never compete for the same decision.
 * Append-only for the same reason `MasteryLedgerEntry` is: a balance that is
 * the sum of its history can be audited and replayed, where a mutable
 * counter silently loses the reason it changed.
 */
model CapitalLedgerEntry {
  id     String  @id @default(cuid())
  userId String
  /**
   * Positive for a claimed dividend, negative for an augment purchase.
   */
  delta  Float
  /**
   * DIVIDEND | AUGMENT | ADJUSTMENT
   */
  reason String
  detail String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason])
  @@schema("public")
}

/**
 * A permanent upgrade burned onto an emblem the user already owns.
 * Keyed by `skillCode` rather than by `UnlockedSkill.id` so an augment
 * survives any future re-issue of the unlock row, and unique per kind so the
 * same emblem cannot be sold the same upgrade twice.
 */
model EmblemAugment {
  id        String @id @default(cuid())
  userId    String
  skillCode String
  /**
   * AugmentKind from augments.ts: AMPLIFY | GRAFT | YIELD | PRESTIGE
   */
  kind      String
  /**
   * Capital actually burned — recorded so a future rebalance can refund honestly.
   */
  costPaid  Float  @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, skillCode, kind])
  @@index([userId])
  @@schema("public")
}

model FieldStreak {
  id            String   @id @default(cuid())
  userId        String
  fieldId       String
  field         Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  currentDays   Int      @default(0)
  bestDays      Int      @default(0)
  lastActiveDay DateTime // truncated to UTC midnight

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@schema("public")
}

model UnlockedSkill {
  id           String   @id @default(cuid())
  userId       String
  skillCode    String
  usesThisWeek Int      @default(0)
  weekAnchor   DateTime @default(now()) // start of the week usesThisWeek is counted against

  /**
   * Mastery points actually spent to unlock — recorded so a future rebalance can refund honestly.
   */
  masteryPaid Int      @default(0)
  unlockedAt  DateTime @default(now())

  /**
   * Loadout slot, 0..9, or null when benched.
   * Owning a skill no longer makes it do anything: only the ten equipped
   * skills fold into `ActiveModifiers`. Unlocking used to be the last
   * decision a player ever made about a skill — with 749 of them and no
   * cap, a long-running account would simply hold every effect at once and
   * the whole tree would collapse into "buy everything". A hard ten-slot
   * bench turns each unlock into an ongoing choice about what to carry.
   * Uniqueness is per (userId, slot), so a slot holds at most one skill;
   * equipping into an occupied slot swaps rather than stacks.
   */
  equippedSlot Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillCode])
  @@unique([userId, equippedSlot])
  @@schema("public")
}

// ── Life: one day clock, one ledger, graded tasks (migration life_core) ─────
//
// The life system extends the knowledge game to the rest of a day: todos,
// habits, compulsory duties, goals, and (later) workouts. Its rules live in
// src/lib/life-*.ts. Everything here is additive: no existing table is
// altered, kinds and reasons are TEXT typed by TS unions, and every "life
// day" column holds the local calendar date that src/lib/life-day.ts
// `dateColumn` produces (a day turns over at 04:00 local).

/// Per-user life settings. Created lazily on the first capture.
model LifeSettings {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// The first life day. Nothing earlier ever pays XP.
  epochDay          DateTime  @db.Date
  dailyCapacityMin  Int       @default(240)
  /// When the player chose dailyCapacityMin. Null: it is still the default, and the Today tile may not warn against it.
  capacitySetAt     DateTime?
  /// 1 = Mon … 7 = Sun: standing rest days (used from M2).
  restWeekdays      Int[]     @default([])
  /// The last life day settlement has judged (M2).
  settledThroughDay DateTime? @db.Date
  /// "Accept the loss" on old debt. Off: debt stays until it is done.
  debtWriteOff      Boolean   @default(false)
  hrMax             Int?
  birthYear         Int?
  /// Unmapped tracker activity code -> exercise kind (M4).
  activityMap       Json?
  /// Per-track weekly targets (M5).
  weeklyTargets     Json?
  /// Roadmap revision 4: "Suggest setting an aim". false is the lasting no; true or null (the default) is on.
  aimSuggestions    Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("public")
}

/// THE append-only life ledger. Every action lands here once: a review, a new
/// Idea, a completed task, an undo, a debt. `sink` says where its XP counts:
/// DOMAIN rows only record points srs.ts / ideas.ts already credited to a
/// Domain (so knowledge is never paid twice), TRACK rows are the life XP, and
/// NONE rows are records. Life levels read only SUM(xp) WHERE sink = 'TRACK'.
/// The daily streak, habit strength and levels are derived from these rows on
/// read; nothing here is a mutable counter. Corrections are new rows.
model ActivityEvent {
  id              String   @id @default(cuid())
  userId          String
  day             DateTime @db.Date
  occurredAt      DateTime
  /// REVIEW, IDEA_CREATE, TASK, UNDO, DAY_OPEN, … (src/lib/life-types.ts).
  source          String
  /// DOMAIN | TRACK | NONE.
  sink            String   @default("NONE")
  /// BODY | DUTY | CRAFT | CARE, for TRACK rows.
  track           String?
  templateId      String?
  /// The Idea / TaskInstance / Workout this row is about. No FK, like MasteryLedgerEntry.ideaId.
  sourceId        String?
  compositionKey  String?
  /// XP paid, after the daily knee.
  xp              Float    @default(0)
  /// XP before the knee; the day's knee base is SUM(rawXp).
  rawXp           Float?
  qty             Float?
  countsForStreak Boolean  @default(false)
  /// The published price breakdown: {v, factors[], raw, kneeBefore, xp, track}.
  receipt         Json?
  detail          String?
  /// Makes automatic writes idempotent ("task:<tpl>:<day>:<slot>:<n>", "dayopen:<day>", …). NULLs allowed.
  dedupeKey       String?
  createdAt       DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, day])
  @@index([userId, source, day])
  @@index([userId, track, day])
  @@index([userId, templateId, day])
  @@index([userId, sourceId])
  @@schema("public")
}

/// A task, habit, duty or goal: the rule it follows and its frozen grade.
/// "AI sizes once, formula scores": a lexical grade is written at capture,
/// Gemini may refine it once within 24 h, and the grade freezes at the first
/// completion. Templates with history are archived, never deleted.
model TaskTemplate {
  id                 String         @id @default(cuid())
  userId             String
  title              String
  /// Lowercase, parse tokens, digits and stop-words stripped: the repeat-decay and grade-copy key.
  normTitle          String
  /// The original capture line, for audit and re-parse.
  rawText            String
  note               String?
  /// TASK | HABIT | GOAL | IDEA_DRAFT.
  kind               String
  inbox              Boolean        @default(false)
  /// DAILY | WEEKDAYS | DOW:1,4 | EVERY:3 | AFTER:3 | TARGET:3/W | TARGET:2/M | MONTHLY:15 (src/lib/recurrence.ts).
  recurrence         String?
  startDay           DateTime       @db.Date
  dueDay             DateTime?      @db.Date
  /// PLANNED (carries forward, never late) | DEADLINE (late after it).
  dueKind            String?
  /// A one-off put off to this life day ('Move to tomorrow' on a deadline): off the board until then. Never moves dueDay or the late factor.
  planDay            DateTime?      @db.Date
  /// SHORT | MID | LONG, for goals.
  horizon            String?
  parentId           String?
  parent             TaskTemplate?  @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           TaskTemplate[] @relation("GoalTree")
  /// CHILDREN | MANUAL | REVIEWS | IDEAS | WORKOUTS | RUN_KM.
  krMetric           String?
  krTarget           Float?
  krUnit             String?
  /// Mastery points a goal pays, frozen when stated (M5).
  goalMp             Float?
  closedScore        Float?
  compulsory         Boolean        @default(false)
  compulsoryOnRest   Boolean        @default(false)
  /// #play: logged and streak-counting, pays 0.
  intrinsic          Boolean        @default(false)
  /// The minimum viable version, e.g. "10 pushups".
  mvv                String?
  mvvMinutes         Int?
  /// REVIEWS | IDEAS | REVIEW_DUE | STEPS | WORKOUT: completes itself from activity.
  autoMetric         String?
  autoTarget         Float?
  autoFamily         String?
  /// BODY | DUTY | CRAFT | CARE.
  track              String
  /// CATEGORY | TAG.
  trackSource        String         @default("CATEGORY")
  category           String
  /// The machine band after the merge: INTRO | STANDARD | DEMANDING | SEVERE.
  band               String
  lexicalBand        String
  aiBand             String?
  /// Self-rating, −3..+1 steps; never above machine + 1.
  bandOverride       Int            @default(0)
  bandOverrideAt     DateTime?
  estMinutes         Int
  machineMinutes     Int
  /// USER | AI | LEXICAL.
  minutesSource      String
  /// Record<Attribute, int> summing to 100; a frozen snapshot.
  composition        Json
  /// LEXICAL | AI | COPIED.
  gradeSource        String
  gradeConfidence    Float
  gradeBasis         String?
  gradeModel         String?
  gradePromptVersion Int?
  gradeAttempts      Int            @default(0)
  aiGradedAt         DateTime?
  gradeCopiedFrom    String?
  gradeFrozenAt      DateTime?
  /// A weakening change waiting out its delay (M2).
  pendingChange      Json?
  pendingChangeAt    DateTime?
  /// quick | share | api | form.
  captureSource      String         @default("quick")
  /// The capture sheet's per-line nonce: a retried save finds the row it already wrote instead of writing a second.
  captureKey         String?
  sortOrder          Float          @default(0)
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  instances          TaskInstance[]

  @@unique([userId, captureKey])
  @@index([userId, archivedAt])
  @@index([userId, normTitle])
  @@index([parentId])
  @@schema("public")
}

/// One occurrence of a template, materialised only when it is acted on or
/// judged. Expected occurrences are a pure function of the rule and the day
/// (src/lib/recurrence.ts) and are never pre-created. Its status is a
/// projection of the ledger.
model TaskInstance {
  id          String       @id @default(cuid())
  userId      String
  templateId  String
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  day         DateTime     @db.Date
  /// "Again" completions use slot n + 1.
  slot        Int          @default(0)
  /// DONE | DONE_LATE | DONE_MVV | MISSED | EXCUSED | SKIPPED | UNDONE | WRITTEN_OFF | MADE_UP (M2: a late make-up; the debt is cleared, the occurrence still reads missed).
  status      String
  /// manual | record-yesterday | make-up | auto:reviews | auto:ideas | auto:steps | auto:workout.
  source      String       @default("manual")
  completedAt DateTime?
  minutes     Int?
  rpe         Int?
  xpPaid      Float        @default(0)
  debtXp      Float        @default(0)
  debtOpen    Boolean      @default(false)
  repaired    Boolean      @default(false)
  judgedAt    DateTime?
  workoutId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([templateId, day, slot])
  @@index([userId, day])
  @@index([userId, debtOpen])
  @@schema("public")
}

/// A declared rest, sick or vacation day (M2, migration life_duty). Read only
/// through src/lib/duty-rule.ts heldDaysOf, which ignores a REST or VACATION
/// row declared at or after its day started, a SICK row declared at or after
/// its day ended, and any cancelled row. Every write upserts by (userId, day)
/// and resets kind, declaredAt and cancelledAt, so a reused row is judged by
/// its new declaration time.
model RestDay {
  id          String    @id @default(cuid())
  userId      String
  /// The life day held (life-day.ts dateColumn).
  day         DateTime  @db.Date
  /// REST | SICK | VACATION.
  kind        String
  declaredAt  DateTime  @default(now())
  /// A future declaration can be cancelled before its day starts; the row is reused by the next declaration.
  cancelledAt DateTime?

  @@unique([userId, day])
  @@schema("public")
}

// ── Celebrations: persisted Seals and Ascensions (migration celebrations) ────
//
// The reward ladder's two loud tiers (redesign.md › Rewards). Detectors in
// src/lib/celebrations.ts diff a before and an after snapshot of progress and
// write each Seal (T2) or Ascension (T3) here once, keyed by an idempotent
// dedupeKey, so a moment plays once across the Fold and the desktop. T0 and T1
// render in place and are never stored. Additive: new tables only, kinds are
// TEXT typed by src/lib/celebration-types.ts, and nothing has a foreign key.

/// One Seal (tier 2) or Ascension (tier 3). Acknowledging sets shownAt; an
/// unseen row surfaces on the next open. You › Moments lists them.
model CelebrationEvent {
  id         String    @id @default(cuid())
  userId     String
  /// 2 = Seal, 3 = Ascension.
  tier       Int
  /// A T2/T3 kind from celebration-types.ts: 'domain-level', 'band', 'emblem-unlock', …
  kind       String
  /// Idempotency, one row per key per user, ever: 'title:Practitioner', 'band:bronze', 'domain:<id>:7', 'streak:30', 'unlock:<code>', …
  dedupeKey  String
  /// CelebrationFacts: eyebrow, title, fact lines, exact amounts, numeral, material, and the T3 text.
  facts      Json
  /// WhatMoved[]: label left, exact value right.
  what       Json      @default("[]")
  /// Set when a louder event from the same diff claimed this key (the level-15 re-forge claims 'title:Practitioner' and 'level:15'). Such a row never plays and is not a Moment.
  mergedInto String?
  createdAt  DateTime  @default(now())
  /// When a device first showed it. Null: still pending.
  shownAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, shownAt])
  @@index([userId, createdAt])
  @@schema("public")
}

/// Settings › Feedback, persisted for the account (savePrefs). theme, motion and
/// autoAdvance follow the account across devices; sound and haptics are per
/// device (the localStorage mirror). Every column is nullable on purpose: null
/// means "never chosen", so a device that saved only its theme never imposes a
/// default motion on another device that chose Still.
model UserPrefs {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// night | vellum
  theme       String?
  /// system | full | calm | still
  motion      String?
  /// off | soft (per device; normally null)
  sound       String?
  /// off | on (per device; normally null)
  haptics     String?
  /// next | wait
  autoAdvance String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

// ── Body weight ────────────────────────────────────────────────────────────
// A record, never a reward: no reading pays XP or MP, and nothing in the
// economy reads these tables. Kept in kilograms; the unit is display only.
// src/lib/weight.ts holds the rules (trend, rate, projection), and
// src/lib/weight-server.ts the reads and writes.

/// One weigh-in per life day: logging again that day replaces it.
model BodyWeight {
  id         String   @id @default(cuid())
  userId     String
  /// The life day (src/lib/life-day.ts dateColumn): a 01:00 weigh-in counts for the day before.
  day        DateTime @db.Date
  /// Kilograms, two decimals.
  kg         Decimal  @db.Decimal(6, 2)
  /// When it was logged (or measured, for an import).
  measuredAt DateTime @default(now())
  /// manual | capture | import
  source     String   @default("manual")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
  @@schema("public")
}

/// The weight goal and the unit weights are shown in. One row per user.
model WeightGoal {
  id        String    @id @default(cuid())
  userId    String    @unique
  /// kg | lb (display only; readings are stored in kg).
  unit      String    @default("kg")
  /// The target, in kg. Null: no target set, the card shows the trend only.
  targetKg  Decimal?  @db.Decimal(6, 2)
  /// An optional date to reach it by (a life day).
  targetDay DateTime? @db.Date
  /// The trend weight when the target was set: the bar measures progress from here.
  startKg   Decimal?  @db.Decimal(6, 2)
  /// When the target was set (a life day).
  startDay  DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("public")
}

// ── Exercise and task style (migration life_exercise_style) ────────────────
// Additive: two new tables, no existing table altered, no foreign keys. Both
// are records, never rewards: nothing in the economy reads them.
// src/lib/exercise-server.ts and src/lib/task-style-server.ts read them fail
// soft (a missing table reads as nothing logged / no style).

/// One exercise session on Train › Exercise. Only WALK for now.
model ExerciseSession {
  id          String   @id @default(cuid())
  userId      String
  /// The life day (src/lib/life-day.ts dateColumn).
  day         DateTime @db.Date
  /// WALK (src/lib/exercise.ts EXERCISE_KINDS).
  kind        String   @default("WALK")
  /// The incline in degrees (0 = flat), as the user set it.
  angleDeg    Float    @default(0)
  distanceKm  Float
  durationMin Float
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, day])
  @@schema("public")
}

/// A task's or habit's icon and colour, chosen by the user (src/lib/task-style.ts names them). One row per template.
model TaskStyle {
  templateId String   @id
  userId     String
  /// A TASK_ICONS name.
  icon       String?
  /// A TASK_COLORS name.
  color      String?
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

// ── Question variants (migration idea_question_variants) ──────────────────
// Additive: one new table, no existing table altered, no foreign keys. Other
// wordings of an idea's question (same answer); a review shows one of them,
// or the original, picked at random (src/lib/idea-variants.ts). Read fail
// soft: a missing table reads as no variants. Never read by dedup, the
// embedding or difficulty: those keep the original question.

/// Another way to ask an idea's question: the prompt only (SHORT, FORMULA: the whole question; LIST, ORDER, NUMERIC: its prompt).
model IdeaVariant {
  id        String   @id @default(cuid())
  ideaId    String
  /// Its place in the idea's list, from 0.
  ord       Int
  prompt    String
  createdAt DateTime @default(now())

  @@index([ideaId])
  @@schema("public")
}

// ── Subtasks (migration life_subtasks) ─────────────────────────────────────
// Additive: two new tables, no existing table altered, no foreign keys. A task
// or habit has no steps until the user adds them in its drawer; ticking steps
// pays a share of the task's own price through its one TASK row (re-priced on
// each change; src/lib/subtasks-server.ts). Read fail soft: a missing table
// reads as no steps.

/// One step of a task or habit, added by the user in the task drawer. Removed steps keep their row (archivedAt).
model TaskSubtask {
  id         String    @id @default(cuid())
  userId     String
  templateId String
  /// The step's place in its list, from 0.
  ord        Int
  title      String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([templateId])
  @@index([userId])
  @@schema("public")
}

/// A step ticked on a life day. One row per step per day.
model TaskSubtaskTick {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  subtaskId  String
  /// The life day (src/lib/life-day.ts dateColumn).
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([subtaskId, day])
  @@index([userId, day])
  @@index([templateId, day])
  @@schema("public")
}

// ── Roadmap: an Aim, its drafts, milestones, measures and week quests ─────
// (migration life_roadmap; docs/life-plan/roadmap.md revision 3, F1)
//
// An Aim the user writes, the structure Gemini (or the app) drafts for it,
// the milestones the user accepts and starts, the measures code sets, the
// readings code writes forward one life day at a time, the acceptance log,
// and each life week's frozen week quests. Additive: eight new tables, no
// existing table is altered, and the only foreign keys run between these
// tables. Field, Domain, Idea and TaskTemplate are referenced by plain TEXT
// ids and read tolerantly (a removed row reads "Domain removed"). Status and
// kind columns are TEXT, typed by the unions in src/lib/roadmap-types.ts.
// Nothing here pays: a started milestone becomes an ordinary MID goal
// (TaskTemplate krMetric 'ROADMAP'), and only GOAL_RULES pay it.

/// One Aim. At most one DRAFT or ACTIVE per user (a claim-first guard under
/// pg_advisory_xact_lock(hashtext('roadmap:' || userId))).
model Roadmap {
  id                 String              @id @default(cuid())
  userId             String
  /// The user's words, shown verbatim everywhere and never rewritten (at most 140 characters).
  aim                String
  /// The Area Field; null for a life-track Area (a practice-only aim).
  fieldId            String?
  /// The Domains the user chose at intake (plain ids; no foreign key).
  domainIds          String[]            @default([])
  /// CRAFT | BODY | CARE | DUTY: the track the practices count toward.
  track              String              @default("CRAFT")
  /// The life day the plan starts (the intake day).
  startDay           DateTime            @db.Date
  /// The aim's date, at most SPAN_MAX_DAYS (1,080) after startDay.
  targetDay          DateTime            @db.Date
  hoursPerWeek       Int
  /// YOURS, asked only when no pace is measured. Null: new cards are not counted until a pace is measured.
  newCardsPerWeek    Int?
  /// YOURS "hours this usually takes" (the aim check), with its source note.
  typicalHours       Int?
  typicalHoursSource String?
  /// YOURS: {lines: string[], source: string | null}.
  syllabus           Json?
  /// NEW | BASICS | WORKING | STRONG.
  startPoint         String
  /// LIGHT | STEADY | PUSH.
  intensity          String              @default("STEADY")
  practicesAllowed   Boolean             @default(true)
  constraints        String?
  examLabel          String?
  /// Revision 4: the aim's depth, the gate level of its final stage (12 Mastered, 10 Fluent, 8 Retained). Null on a track Area and on a plan made before revision 4 (legacy).
  depth              Int?
  /// Revision 4: REALISTIC (the app dates the plan; only on a DRAFT) or CHOSEN.
  dateMode           String              @default("CHOSEN")
  /// Revision 4: YOURS coverage overrides, {[domainId]: number} (only figures the user typed).
  coverage           Json?
  /// Revision 4: "Let Gemini suggest areas" (read only while ROADMAP_GAPS_LIVE).
  suggestAreas       Boolean             @default(false)
  /// Revision 4: the user's exam date (YOURS); a waypoint, never the aim's date, never sent to Gemini.
  examDay            DateTime?           @db.Date
  /// DRAFT | ACTIVE | PAUSED | DONE | ARCHIVED. DRAFT and ACTIVE hold a seat; PAUSED, DONE and ARCHIVED free it (decision 68).
  status             String              @default("DRAFT")
  /// Revision 5: the goal's seat, 1..3. Set on every DRAFT and ACTIVE row from lane 3 on; a PAUSED row keeps its last value outside the index (contracts §22.1 ruling 46); null on rows saved before lane 3.
  /// Not expressible in Prisma 6 (data-model.md): CHECK "Roadmap_slot_range" (slot null or 1..3); partial UNIQUE "Roadmap_userId_slot_open_key" (userId, slot) WHERE status IN ('DRAFT','ACTIVE').
  /// Migration B (lane 5): CHECK "Roadmap_slot_open_required" (status NOT IN ('DRAFT','ACTIVE') OR slot IS NOT NULL): an open row always has a seat.
  slot               Int?
  /// Revision 5: the user's own name for the goal (at most GOAL_LABEL_MAX, 16 characters); null = the Area name.
  label              String?
  pausedAt           DateTime?
  /// Revision 5: the user's reason for a pause (at most GOAL_PAUSE_REASON_MAX, 120 characters).
  pauseReason        String?
  /// Revision 5: the client nonce that created the row ([A-Za-z0-9_-]{8,64}), so a double tap returns the same id.
  /// Not expressible in Prisma 6: partial UNIQUE "Roadmap_userId_createKey_key" (userId, createKey) WHERE createKey IS NOT NULL.
  createKey          String?
  /// Revision 5 (migration B): LEVELS | TOPICS, the live version's kind; every existing row is LEVELS.
  planKind           String              @default("LEVELS")
  /// Revision 5: the RatingRecord (Gemini's difficulty estimate), the live version's; copied to the acceptance.
  rating             Json?
  /// Revision 5: SplitClause[]: the aim's clauses tracked in another goal.
  splitClauses       Json?
  /// Revision 5: DraftPlan (contracts §22.1 ruling 49): an open re-plan draft's {version, planKind, depth, rating} while they differ from the live version's,
  /// as a [Break into topics] draft of a LEVELS plan has them. planKind, depth and rating stay the live version's and change only inside acceptCore's
  /// transaction and undoAcceptCore's. Null on every existing row.
  draftPlan          Json?
  /// The accepted version; 0 before the first acceptance. A draft or re-plan writes its milestones at version + 1.
  version            Int                 @default(0)
  /// Set at the first acceptance (the end-state anchor); cleared only by that acceptance's Undo.
  firstAcceptedDay   DateTime?           @db.Date
  /// Set once, when the aim is reached on confirmed readings; never cleared.
  reachedDay         DateTime?           @db.Date
  doneAt             DateTime?
  /// The user's typed reason when marked done before the aim was reached.
  doneReason         String?
  archivedAt         DateTime?
  archiveReason      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  runs               RoadmapRun[]
  milestones         RoadmapMilestone[]
  acceptances        RoadmapAcceptance[]
  questWeeks         RoadmapQuestWeek[]
  topics             RoadmapTopic[]
  topicEdges         RoadmapTopicEdge[]

  @@index([userId, status])
  @@schema("public")
}

/// One drafting run: a Gemini call (claimed RUNNING, finished in after()),
/// a reuse, or the in-house starter or manual builder. GEMINI runs count
/// toward ROADMAP_DRAFTS_PER_DAY (any status but REUSED).
model RoadmapRun {
  id            String    @id @default(cuid())
  roadmapId     String
  roadmap       Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  userId        String
  /// The life day it was claimed (the cap's day).
  day           DateTime  @db.Date
  /// The version its milestones are written at.
  version       Int
  /// GEMINI | INHOUSE | MANUAL.
  kind          String
  /// RUNNING | OK | PARTIAL | FAILED | CAPPED | REUSED.
  status        String
  model         String?
  modelVersion  String?
  promptVersion Int?
  seedBase      Int?
  inputHash     String?
  /// The exact prompt lines sent, plus the server-only keymap and the sorted domain-id hash.
  pack          Json?
  /// The raw replies (at most 32 KB each), unedited.
  samples       Json?
  /// The ValidationReport: every drop, flag and note with its reason.
  report        Json?
  usage         Json?
  responseIds   String[]  @default([])
  finishReasons String[]  @default([])
  latencyMs     Int?
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// Revision 5: RATE | MAP | LINK | GROUND | DEEPER. Null is a run with no model phase (every LEVELS run, and a TOPICS draft built with no model).
  /// A GEMINI run with a null phase still counts toward ROADMAP_DRAFTS_PER_DAY, and so does phase RATE, the chain head (contracts §22.1 ruling 17).
  phase         String?
  /// Revision 5: GroundRunRecord (webSearchQueries, chunk titles and uris, the verdict per key, the title mode, toolUsePromptTokenCount). Server only, never in a view.
  grounding     Json?
  /// Revision 5: every model request the run made, against ROADMAP_REQUESTS_PER_DAY and GROUNDED_REQUESTS_PER_DAY; older rows read 0 (a LEVELS run writes it from lane 10, ruling 66).
  requests      Int       @default(0)

  @@index([userId, day])
  @@index([userId, inputHash])
  @@index([roadmapId, status])
  @@schema("public")
}

/// One milestone of one version. Rows of an accepted version that are
/// PLANNED, STARTING or STARTED change only through guarded transitions
/// (updateMany on the expected status). CLOSED, DROPPED and REACHED are
/// derived (the goal's closedScore and archivedAt, and reachedDay), never stored.
model RoadmapMilestone {
  id              String             @id @default(cuid())
  roadmapId       String
  roadmap         Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version         Int
  /// Stable across versions and "Start again": a re-plan keeps it for a carried position.
  lineageId       String
  ord             Int
  /// Never contains a target (the target lives in the measure line, rendered at read time).
  title           String
  /// GEMINI | CODE | USER | SYLLABUS.
  titleOrigin     String
  /// PENDING | KEPT | CHECKED | EDITED | REMOVED.
  titleDecision   String             @default("PENDING")
  /// Null on LATER rows.
  windowStart     DateTime?          @db.Date
  dueDay          DateTime?          @db.Date
  /// DRAFT | PLANNED | STARTING | STARTED | LATER | SUPERSEDED | DISCARDED.
  status          String             @default("DRAFT")
  /// The MID goal (a TaskTemplate id, krMetric 'ROADMAP') Start created; no foreign key.
  goalId          String?            @unique
  startedDay      DateTime?          @db.Date
  startingAt      DateTime?
  /// Set once on a confirmed reach; never cleared.
  reachedDay      DateTime?          @db.Date
  /// The day g first reached 1 on a milestone with a self-reported part, until confirmed or cleared.
  reachPendingDay DateTime?          @db.Date
  overAccepted    Boolean            @default(false)
  /// The acceptance's per-milestone snapshot; after Start, its StartSnapshot.
  feasibility     Json?
  /// 1 to 5 on scheduled rows (min(place, RANK_MILESTONE_MAX)); null on LATER rows. Written only by acceptCore on DRAFT rows.
  rankIndex       Int?
  /// Revision 4: FOUNDATION | FAMILIAR | RETAINED | FLUENT | MASTERED | BETWEEN | PART | STAGE_1..STAGE_5; null on rows made before revision 4.
  stage           String?
  /// Revision 5: 1..6 on a TOPICS layer milestone; null on every LEVELS row.
  layer           Int?
  /// Revision 5: LAYER | DEPTH on a TOPICS milestone; null on every LEVELS row.
  chainRole       String?
  createdAt       DateTime           @default(now())
  items           RoadmapItem[]
  measures        RoadmapMeasure[]
  questWeeks      RoadmapQuestWeek[]

  @@index([roadmapId, version, ord])
  @@index([lineageId])
  @@schema("public")
}

/// One Domain, Topic, Practice, Step or Checkpoint of a milestone, with its
/// provenance (origin and decision) and the checker's flags and notes.
model RoadmapItem {
  id              String           @id @default(cuid())
  milestoneId     String
  milestone       RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  lineageId       String
  /// DOMAIN | TOPIC | PRACTICE | STEP | CHECKPOINT.
  kind            String
  ord             Int
  label           String
  /// The text exactly as the model returned it (at most 200 characters).
  rawLabel        String?
  /// GEMINI | CODE | USER | SYLLABUS.
  origin          String
  /// PENDING | KEPT | CHECKED | EDITED | REMOVED.
  decision        String           @default("PENDING")
  decidedAt       DateTime?
  /// A resolved Domain (a DOMAIN item's; a TOPIC's Domain). No foreign key.
  domainId        String?
  /// A proposed new Domain's name, until the user creates or maps it.
  proposedName    String?
  /// The syllabus line index a topic covers.
  syllabusRef     Int?
  /// A practice's method (DELIBERATE_PRACTICE | READING | PROJECT_WORK | COACHED_SESSION | WORKOUT | WRITING).
  method          String?
  sessionsPerWeek Int?
  /// D15 | D20 | D30 | D45 | D60 | D90 | D120.
  durationBand    String?
  /// A recurrence.ts rule: 'DAILY' or 'TARGET:<n>/W', or fixed days the user picked.
  rule            String?
  /// WORKED_OUT | YOURS (sessions, band and rule).
  planSource      String?
  /// MOCK_TEST | PERFORMANCE_CHECK | SELF_TEST.
  checkpointKind  String?
  /// The user's own (YOURS) checkpoint scale and bar.
  outOf           Float?
  bar             Float?
  addToToday      Boolean          @default(true)
  /// The TaskTemplate Start created for a practice or step. No foreign key.
  templateId      String?
  /// Revision 4: the roadmap-catalog.ts key of a practice, step or checkpoint type (its label is re-rendered from it); null otherwise.
  catalogKey      String?
  flags           String[]         @default([])
  notes           String[]         @default([])
  createdAt       DateTime         @default(now())

  @@index([milestoneId])
  @@index([templateId])
  @@index([domainId])
  @@schema("public")
}

/// What a milestone's progress is judged by: CARDS_AT_LEVEL and
/// PRACTICE_KEPT pay (g is their minimum, with the steps' share);
/// CHECKPOINT is context only. measureKey carries no target.
model RoadmapMeasure {
  id             String           @id @default(cuid())
  milestoneId    String
  milestone      RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// CARDS_AT_LEVEL | PRACTICE_KEPT | CHECKPOINT.
  kind           String
  /// PAYS | CONTEXT.
  role           String
  /// {domainIds} | {itemLineageIds, templateIds} | {itemLineageIds} (a checkpoint's one lineage).
  scope          Json
  minLevel       Int?
  target         Float
  /// WORKED_OUT | YOURS.
  targetSource   String
  fittedTarget   Float?
  /// SCOPE | FIELD | YOURS | NONE.
  rateSource     String?
  /// The high-water baseline set at acceptance or Start.
  baseline       Float?
  baselineDay    DateTime?        @db.Date
  unit           String?
  itemLineageId  String?
  measureKey     String?
  /// Revision 5: the RoadmapTopic lineage it measures (display only); null on LEVELS.
  topicLineageId String?
  createdAt      DateTime         @default(now())

  @@index([milestoneId])
  @@index([measureKey])
  @@schema("public")
}

/// A forward-written reading: one row per measureKey per life day. COMPUTED
/// rows are upserted for today only, guarded on source and observedAt;
/// SELF rows (checkpoint logs) are append-only under their own key space.
/// PROFICIENCY|r:<roadmapId> rows hold each ACTIVE roadmap's Proficiency.
/// Raw INSERTs supply their own id (no database default).
model RoadmapReading {
  id         String   @id @default(cuid())
  userId     String
  measureKey String
  day        DateTime @db.Date
  value      Float
  detail     Json?
  /// COMPUTED | SELF.
  source     String   @default("COMPUTED")
  /// When the computation started: an older computation never overwrites a newer one.
  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, measureKey, day])
  @@index([userId, day])
  @@schema("public")
}

/// One acceptance of one version. Never updated, except to set undoneAt once.
model RoadmapAcceptance {
  id                 String    @id @default(cuid())
  roadmapId          String
  roadmap            Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version            Int
  day                DateTime  @db.Date
  acceptedAt         DateTime  @default(now())
  previousVersion    Int
  /// The plan's per-milestone snapshot, each with its per-week plan.
  feasibility        Json
  /// [{measureKey, target, baseline, baselineDay, label}] as accepted.
  endState           Json
  /// The review-spacing multiplier m at acceptance.
  intervalMultiplier Float
  overAccepted       Boolean   @default(false)
  undoneAt           DateTime?
  /// Revision 5: PreviousPlan (contracts ruling 49): the planKind, depth, rating and domainIds an accept of another kind replaced, which undoAcceptCore restores.
  /// Null on every existing row and on any accept that keeps the kind.
  previousPlan       Json?

  @@index([roadmapId, version])
  @@schema("public")
}

/// One life week's week quests for one started milestone, frozen once
/// ('rq:<milestoneId>:<weekStart>', ON CONFLICT DO NOTHING). quests, basis,
/// state, cappedBy, generator and source are never updated; results and
/// finalizedAt are set once, after the week has settled. Week quests pay
/// nothing. Raw INSERTs supply their own id (no database default).
model RoadmapQuestWeek {
  id          String           @id @default(cuid())
  userId      String
  roadmapId   String
  roadmap     Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// The life week's Monday.
  weekStart   DateTime         @db.Date
  dedupeKey   String
  /// CRON | START | RENDER.
  source      String
  /// OPEN | HELD | PAST_DUE.
  state       String           @default("OPEN")
  /// WEEK_QUEST_GENERATOR_VERSION.
  generator   Int
  /// WeekQuestSpec[] as issued; [] for an empty set.
  quests      Json
  /// string[]: what produced each count.
  basis       Json
  /// CATCHUP | CAPACITY | null.
  cappedBy    String?
  /// {closedDay, rows: [{ord, progress, done}], heldAfterFreeze}; null until final.
  results     Json?
  finalizedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([roadmapId, weekStart])
  @@index([milestoneId])
  @@schema("public")
}

// Revision 5 (migration B, lane 5; docs/life-plan/data-model.md, contracts §22).
// Neither topic table has a userId column: like RoadmapMilestone and RoadmapItem,
// ownership is the parent Roadmap's (FK, cascade), and every read goes through a
// roadmap the user owns.

/// One topic of one version's topic map (a TOPICS plan's layer rows).
model RoadmapTopic {
  id         String    @id @default(cuid())
  roadmapId  String
  roadmap    Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  /// The version its map belongs to (a draft or re-plan writes version + 1, as milestones do).
  version    Int
  /// Stable across versions; edges and RoadmapMeasure.topicLineageId point at it.
  lineageId  String
  /// S<n> (outline line n), U<n> (intake Domain n) or T<n> (every other topic); unique per version.
  key        String
  /// 1..6 (LAYERS_MAX).
  layer      Int
  /// What is shown: the exact sample form, the aim's own span, your words, or the Domain's name.
  name       String
  /// The text exactly as the model returned it (at most 200 characters). Server only, never in a view.
  rawName    String?
  /// GEMINI | SYLLABUS | USER | LIBRARY | AIM.
  nameOrigin String
  /// GENERAL | REGION_SPECIFIC; null when the name is not Gemini's.
  scope      String?
  /// GEMINI | YOU | CODE: who set its layer.
  placedBy   String
  /// LINKED | WEAK | NONE | NOT_RUN | OWN (OWN: a name that was never Gemini's).
  grounding  String
  /// At most 5 {title, uri}, from groundingChunks.web only.
  sources    Json      @default("[]")
  /// Samples holding the exact form (or the aim's span), 0..3; valid samples of the phase.
  formVotes  Int       @default(0)
  samples    Int       @default(0)
  /// Each voting sample's layer.
  layerVotes Json      @default("[]")
  /// PENDING | KEPT | EDITED | REMOVED | MERGED.
  decision   String    @default("PENDING")
  /// The lineage id it was merged into (MERGED).
  mergedInto String?
  chosen     Boolean   @default(false)
  /// BASE | DEEP (DEEP: chosen in the last layer, the specialisation).
  role       String    @default("BASE")
  /// Its Domain once bound or created at accept. No foreign key, like Roadmap.domainIds.
  domainId   String?
  /// You bound it ([Use my Domain…], or a seed or a pick you ticked).
  bound      Boolean   @default(false)
  /// "Held when you began" (measured at accept).
  heldDay    DateTime? @db.Date
  /// "I know this" (your skip).
  skippedDay DateTime? @db.Date
  flags      String[]  @default([])
  notes      String[]  @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([roadmapId, version, key])
  @@index([roadmapId, version])
  @@index([domainId])
  @@schema("public")
}

/// A "builds on" link; the whole-layer default ("after layer N") is no row at all.
model RoadmapTopicEdge {
  id              String   @id @default(cuid())
  roadmapId       String
  roadmap         Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version         Int
  /// For a cross-goal parent: "x:<parentDomainId>" (CROSS_GOAL_PARENT_PREFIX; the Domain is the parent), so one child's edges to two other goals' Domains keep distinct keys (contracts §22.1 ruling 48).
  parentLineageId String
  childLineageId  String
  /// Cross-goal only: the other goal's Domain and roadmap. Read-only: it can open a gate, and pays and counts nothing here.
  parentDomainId  String?
  parentRoadmapId String?
  /// GEMINI | USER | CODE | SYLLABUS | CROSS_GOAL (CODE and SYLLABUS are reserved; nothing writes them in this build).
  origin          String
  /// Valid LINK samples that chose it; valid LINK samples for that child.
  votes           Int      @default(0)
  samples         Int      @default(0)
  /// A GEMINI edge counts as a parent only when drawn (3 of 3 valid replies, previous layer of at least 4 kept topics).
  drawn           Boolean  @default(false)
  /// PENDING | KEPT | EDITED | REMOVED.
  decision        String   @default("PENDING")
  /// OUTLINE | LINE_DOMAIN | NONE (C8).
  match           String   @default("NONE")
  createdAt       DateTime @default(now())

  // Named explicitly: the default name is 69 characters, over Postgres's 63.
  @@unique([roadmapId, version, parentLineageId, childLineageId], map: "RoadmapTopicEdge_version_parent_child_key")
  @@schema("public")
}
