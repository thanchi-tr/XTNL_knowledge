<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9+: draw into the display cutout's short edges (the front display's punch hole). -->
    <style name="Theme.Xtnl" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/xtnl_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
