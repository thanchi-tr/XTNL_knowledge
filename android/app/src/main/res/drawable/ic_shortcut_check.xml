<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut. Quick check: a check mark inside a ring.
     48 dp: the icon's navy chip (r 22) with mint 2 dp round-capped strokes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path
        android:name="chip"
        android:pathData="M2,24a22,22 0 1,0 44,0a22,22 0 1,0 -44,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="6.4" android:startY="2" android:endX="41.6" android:endY="46">
                <item android:offset="0" android:color="#FF0F1E2E" />
                <item android:offset="1" android:color="#FF04080F" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:name="ring"
        android:pathData="M15,24a9,9 0 1,0 18,0a9,9 0 1,0 -18,0z"
        android:strokeColor="#FF00CC7A"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.9" />
    <path
        android:name="check"
        android:pathData="M19.9,24.3L22.7,27.1L28.3,21.3"
        android:strokeColor="#FF3DFFB0"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
