<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the flows, each opened directly. Check in (health phase 2) opens the check-in sheet over
     Quick check; it shows no value, as no shortcut does. It is placed second, so a launcher that shows four (or two,
     with a notification showing) keeps it: static shortcuts rank in the order they are declared. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_check"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_check"
        android:shortcutShortLabel="@string/sc_check_short"
        android:shortcutLongLabel="@string/sc_check_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.xtnl.app"
            android:targetClass="com.xtnl.app.MainActivity"
            android:data="xtnl://app/check" />
    </shortcut>
    <shortcut
        android:shortcutId="check_in"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_checkin"
        android:shortcutShortLabel="@string/sc_checkin_short"
        android:shortcutLongLabel="@string/sc_checkin_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.xtnl.app"
            android:targetClass="com.xtnl.app.MainActivity"
            android:data="xtnl://app/checkin" />
    </shortcut>
    <shortcut
        android:shortcutId="quick_task"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_task"
        android:shortcutShortLabel="@string/sc_task_short"
        android:shortcutLongLabel="@string/sc_task_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.xtnl.app"
            android:targetClass="com.xtnl.app.MainActivity"
            android:data="xtnl://app/log?section=task" />
    </shortcut>
    <shortcut
        android:shortcutId="new_idea"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_idea"
        android:shortcutShortLabel="@string/sc_idea_short"
        android:shortcutLongLabel="@string/sc_idea_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.xtnl.app"
            android:targetClass="com.xtnl.app.MainActivity"
            android:data="xtnl://app/idea" />
    </shortcut>
    <shortcut
        android:shortcutId="review"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_review"
        android:shortcutShortLabel="@string/sc_review_short"
        android:shortcutLongLabel="@string/sc_review_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.xtnl.app"
            android:targetClass="com.xtnl.app.MainActivity"
            android:data="xtnl://app/review" />
    </shortcut>
</shortcuts>
