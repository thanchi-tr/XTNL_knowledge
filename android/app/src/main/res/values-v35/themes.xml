<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: edge to edge is the default and the app is built for it
         (Compose draws behind the bars and pads with the window insets). -->
    <style name="Theme.Xtnl" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/xtnl_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
